<%# message--continued: not the last of its group (no meta below it), so the next bubble sits closer %>
<div class="message message--<%= @message.sender %> <%= "message--continued" unless @show_meta %>">
  <div class="message__bubble"><%= @message.text %></div>
  <% if @show_meta %>
    <div class="message__meta">
      <%# Who wrote it: the employee's name, or just "Empleado" for older messages without one %>
      <% if @message.employee? %>
        <span><%= @message.employee&.display_name || t("shared.message_senders.employee") %></span>
      <% elsif @message.sender %>
        <span><%= t(@message.sender, scope: "shared.message_senders") %></span>
      <% end %>
      <% if @message.created_at %>
        <span aria-hidden="true">·</span>
        <time datetime="<%= @message.created_at.iso8601 %>"><%= @message.created_at.strftime("%H:%M") %></time>
      <% end %>
      <% if @message.delivery_status.present? %>
        <span aria-hidden="true">·</span>
        <span><%= t(@message.delivery_status, scope: "shared.delivery_statuses", default: @message.delivery_status.humanize) %></span>
      <% end %>
    </div>
  <% end %>
</div>
