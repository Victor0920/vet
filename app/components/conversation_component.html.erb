<div class="conversation">
  <div class="conversation__messages">
    <% @conversation.messages.each do |message| %>
      <%= render MessageComponent.new(message: message, linked: @linkMessages) %>
    <% end %>
  </div>
  <% if @conversation.messages.empty? %>
    <p class="conversation__empty"><%= t("components.conversation.empty") %></p>
  <% end %>
</div>
