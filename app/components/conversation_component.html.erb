<div class="conversation">
  <div class="conversation__messages">
    <%# messages[i + 1] is nil for the last one: show_meta? (conversation_component.rb) compares each
        message with the next to decide whether it closes a group and shows its sender and time %>
    <% messages.each_with_index do |message, i| %>
      <%= render MessageComponent.new(message: message, show_meta: show_meta?(message, messages[i + 1])) %>
    <% end %>
  </div>
  <% if messages.empty? %>
    <p class="conversation__empty"><%= t("components.conversation.empty") %></p>
  <% end %>
</div>
