<aside class="sidebar">
  <%= link_to helpers.root_path, class: "sidebar__brand" do %>
    <span class="brand-mark"><%= render partial: "shared/paw_icon" %></span>
    <span class="sidebar__brand-name">Vet</span>
  <% end %>

  <nav class="sidebar__nav" aria-label="Main">
    <%= link_to helpers.root_path, class: "sidebar__link", aria: { current: ("page" if request.path == "/") } do %>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
        /></svg>
      <span>Home</span>
    <% end %>
  </nav>

  <div class="sidebar__section-label">Messaging</div>
  <nav class="sidebar__nav" aria-label="Messaging">
    <%= link_to helpers.conversations_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/conversations")) } do %>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155"
        /></svg>
      <span>Conversations</span>
    <% end %>
    <%= link_to helpers.messages_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/messages")) } do %>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"
        /></svg>
      <span>All messages</span>
    <% end %>
  </nav>

  <div class="sidebar__section-label">Clinic</div>
  <nav class="sidebar__nav" aria-label="Clinic">
    <%= link_to helpers.customers_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/customers")) } do %>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"
        /></svg>
      <span>All Customers</span>
    <% end %>
  </nav>

  <% employee = Current.session&.employee %>
  <div class="sidebar__footer">
    <span class="avatar avatar--sm"><%= employee&.email_address.to_s.first %></span>
    <span class="sidebar__user" title="<%= employee&.email_address %>"><%= employee&.email_address %></span>
    <%= button_to helpers.session_path, method: :delete, class: "btn btn--ghost btn--sm", title: "Sign out", aria: { label: "Sign out" } do %>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"
        /></svg>
    <% end %>
  </div>
</aside>
