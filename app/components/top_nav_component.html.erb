<aside class="sidebar">
  <%= link_to helpers.root_path, class: "sidebar__brand" do %>
    <span class="brand-mark"><%= render partial: "shared/paw_icon" %></span>
    <span class="sidebar__brand-name"><%= @enterprise&.name %></span>
  <% end %>

  <nav class="sidebar__nav" aria-label="<%= t("components.top_nav.main") %>">
    <%= link_to helpers.root_path, class: "sidebar__link", aria: { current: ("page" if request.path == "/") } do %>
      <%= render "shared/icons/home" %>
      <span><%= t("components.top_nav.home") %></span>
    <% end %>
  </nav>

  <div class="sidebar__section-label"><%= t("components.top_nav.messaging") %></div>
  <nav class="sidebar__nav" aria-label="<%= t("components.top_nav.messaging") %>">
    <%= link_to helpers.conversations_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/conversations")) } do %>
      <%= render "shared/icons/messages" %>
      <span><%= t("components.top_nav.conversations") %></span>
    <% end %>
    <%= link_to helpers.messages_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/messages")) } do %>
      <%= render "shared/icons/tray_box" %>
      <span><%= t("components.top_nav.all_messages") %></span>
    <% end %>
  </nav>

  <div class="sidebar__section-label"><%= t("components.top_nav.clinic") %></div>
  <nav class="sidebar__nav" aria-label="<%= t("components.top_nav.clinic") %>">

    <%= link_to helpers.appointments_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/appointments")) } do %>
      <%= render "shared/icons/calendar" %>
      <span><%= t("components.top_nav.calendar") %></span>
    <% end %>
    <%= link_to helpers.customers_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/customers")) } do %>
      <%= render "shared/icons/customers" %>
      <span><%= t("components.top_nav.customers") %></span>
    <% end %>
    <%= link_to helpers.invoices_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/invoices")) } do %>
      <%= render "shared/icons/document_text" %>
      <span><%= t("components.top_nav.invoices") %></span>
    <% end %>
  </nav>

  <%# Admin area. Stores live under /settings/stores, so start_with? keeps it highlighted there too %>
  <div class="sidebar__section-label"><%= t("components.top_nav.admin") %></div>
  <nav class="sidebar__nav" aria-label="<%= t("components.top_nav.admin") %>">
    <%= link_to helpers.products_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/products")) } do %>
      <%= render "shared/icons/shopping_bag" %>
      <span><%= t("components.top_nav.products") %></span>
    <% end %>
    <%= link_to helpers.services_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/services")) } do %>
      <%= render "shared/icons/heart" %>
      <span><%= t("components.top_nav.services") %></span>
    <% end %>
    <%= link_to helpers.reports_sales_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/reports/sales")) } do %>
      <%= render "shared/icons/chart_bar" %>
      <span><%= t("components.top_nav.sales_report") %></span>
    <% end %>
    <%= link_to helpers.settings_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/settings")) } do %>
      <%= render "shared/icons/cog" %>
      <span><%= t("components.top_nav.settings") %></span>
    <% end %>
  </nav>

  <%# You: photo (or initials) and name, linking to /profile, where you also sign out %>
  <div class="sidebar__footer">
    <%= link_to helpers.profile_path, class: "sidebar__profile",
          aria: { current: ("page" if request.path == helpers.profile_path) } do %>
      <% if @employee.photo.attached? %>
        <%= image_tag @employee.photo.variant(resize_to_fill: [64, 64]), alt: "", class: "avatar avatar--sm avatar--photo" %>
      <% else %>
        <span class="avatar avatar--sm"><%= (
            @employee.first_name.to_s.first.to_s + @employee.last_name.to_s.first.to_s
          ).presence || @employee.username.first.upcase %></span>
      <% end %>
      <span class="sidebar__user" title="<%= @employee.display_name %>"><%= @employee.display_name %></span>
    <% end %>
  </div>
</aside>
