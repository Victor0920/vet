<aside class="sidebar">
  <%= link_to helpers.root_path, class: "sidebar__brand" do %>
    <span class="brand-mark"><%= render partial: "shared/paw_icon" %></span>
    <span class="sidebar__brand-name"><%= @enterprise&.name %></span>
  <% end %>

  <nav class="sidebar__nav" aria-label="<%= t("components.top_nav.main") %>">
    <%= link_to helpers.root_path, class: "sidebar__link", aria: { current: ("page" if request.path == "/") } do %>
      <%= render "shared/icons/home" %>
      <span><%= t("components.top_nav.home") %></span>
    <% end %>
  </nav>

  <div class="sidebar__section-label"><%= t("components.top_nav.messaging") %></div>
  <nav class="sidebar__nav" aria-label="<%= t("components.top_nav.messaging") %>">
    <%= link_to helpers.conversations_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/conversations")) } do %>
      <%= render "shared/icons/messages" %>
      <span><%= t("components.top_nav.conversations") %></span>
    <% end %>
    <%= link_to helpers.messages_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/messages")) } do %>
      <%= render "shared/icons/tray_box" %>
      <span><%= t("components.top_nav.all_messages") %></span>
    <% end %>
  </nav>

  <div class="sidebar__section-label"><%= t("components.top_nav.clinic") %></div>
  <nav class="sidebar__nav" aria-label="<%= t("components.top_nav.clinic") %>">

    <%= link_to helpers.appointments_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/appointments")) } do %>
      <%= render "shared/icons/calendar" %>
      <span><%= t("components.top_nav.calendar") %></span>
    <% end %>
    <%= link_to helpers.customers_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/customers")) } do %>
      <%= render "shared/icons/customers" %>
      <span><%= t("components.top_nav.customers") %></span>
    <% end %>
    <%= link_to helpers.products_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/product")) } do %>
      <%= render "shared/icons/shopping_bag" %>
      <span><%= t("components.top_nav.products") %></span>
    <% end %>
    <%= link_to helpers.invoices_path, class: "sidebar__link", aria: { current: ("page" if request.path.start_with?("/invoice")) } do %>
      <%= render "shared/icons/shopping_bag" %>
      <span><%= t("components.top_nav.invoices") %></span>
    <% end %>

  </nav>

  <% employee = Current.session&.employee %>
  <div class="sidebar__footer">

    <%= link_to helpers.employee_path(employee) do %>
      <span class="avatar avatar--sm"><%= employee&.email_address.to_s.first %></span>
      <span class="sidebar__user" title="<%= employee&.email_address %>"><%= employee&.email_address %></span>
    <% end %>
    <%= button_to helpers.session_path, method: :delete, class: "btn btn--ghost btn--sm", title: t("components.top_nav.sign_out"), aria: { label: t("components.top_nav.sign_out") } do %>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"
        /></svg>
    <% end %>
  </div>
</aside>
