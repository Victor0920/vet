<% content_for :title, @category.name.presence || t("product_categories.number", id: @category.id) %>

<%= render "shared/back_link", path: product_categories_path, label: t("product_categories.all_categories") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= @category.name.presence || t("product_categories.unnamed") %></h1>
    <p class="page-header__subtitle">
      <%= t("product_categories.number", id: @category.id) %> · <%= t("product_categories.products_count", count: @products.size) %> ·
      <% if @category.updated_by %>
        <%= t(".updated_by", time: time_ago_in_words(@category.updated_at), name: @category.updated_by.display_name) %>
      <% else %>
        <%= t(".updated", time: time_ago_in_words(@category.updated_at)) %>
      <% end %>
    </p>
  </div>
  <div class="page-header__actions">
    <%# Opens the products list already filtered by this category %>
    <%= link_to t(".view_in_products"), products_path(category_id: @category.id), class: "btn btn--ghost" %>
    <%= link_to edit_product_category_path(@category), class: "btn btn--secondary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
        /><path
          d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
        /></svg>
      <%= t(".edit_category") %>
    <% end %>
    <%# Admins only. The warning counts this category's products, which dependent: :nullify
        leaves uncategorized instead of deleting them %>
    <% if admin? %>
      <%= button_to product_category_path(@category), method: :delete, class: "btn btn--danger",
            form: { data: { turbo_confirm: (@products.any? ? t(".delete_confirm_with_products", count: @products.size) : t(".delete_confirm")), confirm_button: t("shared.delete") } } do %>
        <%= render "shared/icons/trash" %>
        <%= t("shared.delete") %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @products.any? %>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th class="products-table__photo"><span class="sr-only"><%= t("products.columns.photo") %></span></th>
          <th><%= t("products.columns.product") %></th>
          <th class="products-table__price"><%= t("products.columns.price") %></th>
          <th class="products-table__vat"><%= t("products.columns.vat") %></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <%# Same thumbnail as products#index (classes in products.css) %>
            <td class="products-table__photo">
              <%# Same destination as the name link, so it's skipped by keyboard and screen readers %>
              <%= link_to product_path(product), tabindex: -1, aria: { hidden: true } do %>
                <% if product.photo.attached? %>
                  <%# 80×80 for a 40px thumbnail, so it stays sharp on retina screens %>
                  <%= image_tag product.photo.variant(resize_to_fill: [80, 80]), alt: "",
                        class: "product-thumb", loading: "lazy" %>
                <% else %>
                  <span class="product-thumb"><%= render "shared/icons/shopping_bag" %></span>
                <% end %>
              <% end %>
            </td>
            <td>
              <div class="product-cell">
                <%= link_to product.name.presence || t("products.unnamed"), product_path(product),
                      class: "product-cell__name" %>
                <% if product.archived? %>
                  <span class="badge product-cell__archived"><%= t("shared.archived") %></span>
                <% end %>
                <% if product.description.present? %>
                  <span class="product-cell__meta"><%= product.description %></span>
                <% end %>
              </div>
            </td>
            <td class="table__numeric products-table__price">
              <%= product.price ? number_to_currency(product.price_with_vat, unit: "€", format: "%n %u") : "—" %>
            </td>
            <td class="table__numeric products-table__vat">
              <%= number_to_percentage(product.vat_rate, precision: 2, strip_insignificant_zeros: true) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <%= render "shared/paw_icon" %>
    <p class="empty-state__title"><%= t(".empty") %></p>
    <p><%= t(".empty_hint") %></p>
  </div>
<% end %>
