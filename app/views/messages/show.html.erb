<% content_for :title, "Message ##{@message.id}" %>

<% if @message.conversation_id %>
  <%= link_to conversation_path(@message.conversation_id), class: "back-link" do %>
    ← Back to conversation
  <% end %>
<% end %>

<div class="page-header">
  <div>
    <h1 class="page-header__title">Message #<%= @message.id %></h1>
    <p class="page-header__subtitle">Sent <%= @message.created_at.strftime("%b %-d, %Y at %H:%M") %></p>
  </div>
</div>

<section class="card">
  <div class="card__body">
    <dl class="details">
      <div>
        <dt>Text</dt>
        <dd><%= @message.text %></dd>
      </div>
      <div>
        <dt>Sender</dt>
        <dd><span class="badge <%= "badge--primary" unless @message.user? %>"><%= @message.sender&.humanize || "Unknown" %></span></dd>
      </div>
      <div>
        <dt>Delivery status</dt>
        <dd><%= @message.delivery_status.presence&.humanize || "—" %></dd>
      </div>
      <% if @message.whatsapp_message_id.present? %>
        <div>
          <dt>WhatsApp ID</dt>
          <dd><code><%= @message.whatsapp_message_id %></code></dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>
