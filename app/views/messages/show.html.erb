<% content_for :title, t(".number", id: @message.id) %>

<% if @message.conversation_id %>
  <%= render "shared/back_link", path: conversation_path(@message.conversation_id), label: t(".back") %>
<% end %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= t(".number", id: @message.id) %></h1>
    <p class="page-header__subtitle"><%= t(".sent", time: l(@message.created_at, format: :full)) %></p>
  </div>
</div>

<section class="card">
  <div class="card__body">
    <dl class="details">
      <div>
        <dt><%= t(".text") %></dt>
        <dd><%= @message.text %></dd>
      </div>
      <div>
        <dt><%= t(".sender") %></dt>
        <dd><span class="badge <%= "badge--primary" unless @message.user? %>"><%= @message.sender ? t(@message.sender, scope: "shared.message_senders", default: @message.sender.humanize) : t("shared.unknown") %></span></dd>
      </div>
      <div>
        <dt><%= t(".delivery_status") %></dt>
        <dd><%= @message.delivery_status.present? ? t(@message.delivery_status, scope: "shared.delivery_statuses", default: @message.delivery_status.humanize) : "—" %></dd>
      </div>
      <% if @message.whatsapp_message_id.present? %>
        <div>
          <dt><%= t(".whatsapp_id") %></dt>
          <dd><code><%= @message.whatsapp_message_id %></code></dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>
