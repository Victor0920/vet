<% content_for :title, t(".title") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= t(".title") %></h1>
    <p class="page-header__subtitle"><%= t(".subtitle", count: @messages.size) %></p>
  </div>
</div>

<% if @messages.any? %>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th><%= t(".columns.id") %></th>
          <th><%= t(".columns.message") %></th>
          <th><%= t(".columns.sender") %></th>
          <th><%= t(".columns.status") %></th>
          <th><%= t(".columns.sent") %></th>
        </tr>
      </thead>
      <tbody>
        <% @messages.each do |message| %>
          <tr>
            <td class="table__numeric">#<%= message.id %></td>
            <td class="table__truncate"><%= link_to message.text, message_path(message) %></td>
            <td><span class="badge <%= "badge--primary" unless message.user? %>"><%= message.sender ? t(message.sender, scope: "shared.message_senders", default: message.sender.humanize) : t("shared.unknown") %></span></td>
            <td><%= message.delivery_status.present? ? t(message.delivery_status, scope: "shared.delivery_statuses", default: message.delivery_status.humanize) : "—" %></td>
            <td class="table__numeric"><%= l(message.created_at, format: :short_datetime) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <p class="empty-state__title"><%= t(".empty") %></p>
    <p><%= t(".empty_hint") %></p>
  </div>
<% end %>
