<%# HTML email sent by FeedbackMailer#submitted to the developer, wrapped in layouts/mailer.html.erb.
    Inline styles (like invoice_mailer/invoice) because many email apps ignore <style> %>
<% employee = @feedback.employee&.display_name || t("developer.feedbacks.index.deleted_employee") %>

<h1 style="margin: 0 0 8px; font-size: 20px; font-weight: 600; line-height: 1.3; color: #0f172a;">
  <%= t(".heading", kind: t(@feedback.kind, scope: "feedbacks.kinds")) %>
</h1>

<p style="margin: 0 0 24px;">
  <%= t(".intro", employee: employee, enterprise: @feedback.enterprise.name) %>
</p>

<div style="margin: 0 0 24px; padding: 12px 16px; border-left: 3px solid #0d9488; background-color: #f8fafc; color: #334155;">
  <%= simple_format(@feedback.message, {}, wrapper_tag: "p") %>
</div>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 24px; border-collapse: collapse;">
  <tr>
    <td style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; color: #64748b;"><%= Feedback.human_attribute_name(:page_url) %></td>
    <td align="right" style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; color: #0f172a; word-break: break-all;"><%= @feedback.page_url.presence || "—" %></td>
  </tr>
  <tr>
    <td style="padding: 8px 0; color: #64748b;"><%= Feedback.human_attribute_name(:images) %></td>
    <td align="right" style="padding: 8px 0; color: #0f172a;"><%= @feedback.images.size %></td>
  </tr>
</table>

<p style="margin: 0;">
  <a href="<%= developer_feedback_url(@feedback) %>" style="display: inline-block; padding: 10px 16px; border-radius: 6px; background-color: #0d9488; color: #ffffff; font-weight: 600; text-decoration: none;"><%= t(".view") %></a>
</p>
