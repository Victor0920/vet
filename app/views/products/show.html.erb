<% content_for :title,
@product.name.presence || t("products.number", id: @product.id) %>

<%= link_to products_path, class: "back-link" do %>
  <svg
    viewBox="0 0 20 20"
    fill="currentColor"
    width="16"
    height="16"
    aria-hidden="true"
  ><path
      fill-rule="evenodd"
      d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z"
      clip-rule="evenodd"
    /></svg>
  <%= t("products.all_products") %>
<% end %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= @product.name.presence || t("products.unnamed") %></h1>
    <p class="page-header__subtitle"><%= t("products.number", id: @product.id) %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to edit_product_path(@product), class: "btn btn--secondary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
        /><path
          d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
        /></svg>
      <%= t(".edit_product") %>
    <% end %>
  </div>
</div>

<section class="card product-card">
  <div class="card__body product-card__layout">
    <% if @product.photo.attached? %>
      <%# Thumbnail opens the original, full-size file in a new tab.
          320×320 for a 160px box, so it stays sharp on retina screens. %>
      <%= link_to rails_blob_path(@product.photo, disposition: "inline"), target: "_blank",
            class: "product-card__photo", title: t(".view_photo") do %>
        <%= image_tag @product.photo.variant(resize_to_fill: [320, 320]),
              alt: @product.name.to_s, class: "product-thumb product-thumb--xl" %>
      <% end %>
    <% end %>

    <dl class="details details--grid">
      <div>
        <dt><%= Product.human_attribute_name(:product_category) %></dt>
        <dd>
          <%= link_to @product.product_category.name.presence || t("shared.unnamed"),
          product_category_path(@product.product_category),
          class: "badge badge--primary" %>
        </dd>
      </div>
      <div>
        <dt><%= Product.human_attribute_name(:price) %></dt>
        <dd><%= if @product.price
            number_to_currency(@product.price, unit: "€", format: "%n %u")
          else
            "—"
          end %></dd>
      </div>
      <div>
        <dt><%= t(".created") %></dt>
        <dd><%= l(@product.created_at, format: :display) %></dd>
      </div>
      <div>
        <dt><%= t("shared.last_updated") %></dt>
        <dd>
          <%# updated_by is empty for rows changed before it existed, or from the console %>
          <% if @product.updated_by %>
            <%= t(
              "shared.time_ago_by",
              time: time_ago_in_words(@product.updated_at),
              name: @product.updated_by.display_name,
            ) %>
          <% else %>
            <%= t("shared.time_ago", time: time_ago_in_words(@product.updated_at)) %>
          <% end %>
        </dd>
      </div>
      <div class="details__wide">
        <dt><%= Product.human_attribute_name(:description) %></dt>
        <dd><%= @product.description.presence || "—" %></dd>
      </div>
    </dl>
  </div>
</section>
