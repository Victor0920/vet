<% content_for :title, @product.name.presence || "Product ##{@product.id}" %>

<%= link_to products_path, class: "back-link" do %>
  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"/></svg>
  All products
<% end %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= @product.name.presence || "Unnamed product" %></h1>
    <p class="page-header__subtitle">Product #<%= @product.id %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to edit_product_path(@product), class: "btn btn--secondary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
        /><path
          d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
        /></svg>
      Edit product
    <% end %>
  </div>
</div>

<section class="card product-card">
  <div class="card__body">
    <dl class="details details--grid">
      <div>
        <dt>Category</dt>
        <dd>
          <%= link_to @product.product_category.name.presence || "Unnamed",
                product_category_path(@product.product_category),
                class: "badge badge--primary" %>
        </dd>
      </div>
      <div>
        <dt>Price</dt>
        <dd><%= @product.price ? number_to_currency(@product.price, unit: "€", format: "%n %u") : "—" %></dd>
      </div>
      <div class="details__wide">
        <dt>Description</dt>
        <dd><%= @product.description.presence || "—" %></dd>
      </div>
      <div>
        <dt>Created</dt>
        <dd><%= @product.created_at.strftime("%b %-d, %Y") %></dd>
      </div>
      <div>
        <dt>Last updated</dt>
        <dd><%= time_ago_in_words(@product.updated_at) %> ago</dd>
      </div>
    </dl>
  </div>
</section>
