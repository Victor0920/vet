<%# One appointment block inside a time grid.
    The title link is "stretched" over the whole block (see .cal-event__title::after),
    so clicking anywhere opens the edit modal. The customer/pet links sit above it,
    because links can't be nested inside other links.
    A room with a colour adds color-swatch--<name> (sets --swatch / --swatch-highlight, see
    color_picker.css) and cal-event--themed, which paints the block with them (calendar.css) %>
<div class="cal-event <%= "cal-event--themed color-swatch--#{appointment.room.color}" if appointment.room.color %>" style="<%= style %>">
  <%= link_to appointment.title.presence || t("shared.untitled"), edit_appointment_path(appointment, view: @view, filter_room_id: @room&.id),
        class: "cal-event__title",
        data: { turbo_frame: "modal" } %>
  <span class="cal-event__time">
    <%= l(appointment.starts_at, format: :hour) %>–<%= l(appointment.ends_at, format: :hour) %>
    <% if show_room %> · <%= appointment.room.name %><% end %>
  </span>

  <% if appointment.customer || appointment.pet %>
    <span class="cal-event__links">
      <% if appointment.customer %>
        <%= link_to appointment.customer.full_name, customer_path(appointment.customer, return_to: request.fullpath), class: "cal-event__link", data: { turbo_frame: "_top" } %>
      <% end %>
      <% if appointment.pet %>
        <%= link_to appointment.pet.name.presence || t("shared.unnamed_pet"),
              customer_pet_path(appointment.pet.customer, appointment.pet, return_to: request.fullpath),
              class: "cal-event__link cal-event__link--pet",
              data: { turbo_frame: "_top" } %>
      <% end %>
    </span>
  <% end %>
</div>
