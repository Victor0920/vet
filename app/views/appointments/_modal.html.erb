<%# Modal shell for new/edit. Used as a layout: render layout: "modal", locals: { title: "…" } do … end %>
<%= turbo_frame_tag "modal" do %>
  <div class="modal" data-controller="modal" data-action="keydown.esc@window->modal#close turbo:submit-end->modal#submitEnd">
    <div class="modal__backdrop" data-action="click->modal#close"></div>

    <div class="modal__panel card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <header class="card__header">
        <h2 class="card__title" id="modal-title"><%= title %></h2>
        <%= link_to appointments_path(calendar_return_params),
              class: "btn btn--ghost btn--icon btn--sm",
              aria: { label: "Close" },
              data: { action: "modal#close", turbo_frame: "_top" } do %>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
        <% end %>
      </header>

      <%= yield %>
    </div>
  </div>
<% end %>
