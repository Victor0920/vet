<%# Rooms view: one column per room for @date, with free gaps highlighted %>
<% if @rooms.empty? %>
  <div class="empty-state">
    <%= render "shared/paw_icon" %>
    <p class="empty-state__title">This store has no rooms yet</p>
    <p>Add rooms to <%= @store.name %> to see their availability here.</p>
  </div>
<% else %>
  <% slots = calendar_slots(@date) %>
  <% day_appointments = appointments_on(@date) %>

  <div class="time-grid time-grid--rooms card" style="--columns: <%= @rooms.size %>; --slots: <%= slots.size %>;">
    <div class="time-grid__head">
      <div class="time-grid__corner"></div>
      <% @rooms.each do |room| %>
        <div class="time-grid__day">
          <span class="time-grid__weekday">Room</span>
          <span class="time-grid__room"><%= room.name %></span>
        </div>
      <% end %>
    </div>

    <div class="time-grid__body">
      <div class="time-grid__hours">
        <% slots.each do |slot| %>
          <div class="time-grid__hour"><%= slot.strftime("%H:%M") if slot.min.zero? %></div>
        <% end %>
      </div>

      <% @rooms.each do |room| %>
        <% room_appointments = day_appointments.select { |appointment| appointment.room_id == room.id } %>

        <div class="time-grid__column">
          <div class="time-grid__events">
            <% room_gaps(room_appointments, @date).each do |from, to| %>
              <%= link_to new_appointment_path(store_id: @store.id, view: @view, room_id: room.id, starts_at: from.iso8601),
                    class: "cal-gap",
                    style: calendar_position(from, to, @date),
                    data: { turbo_frame: "modal" } do %>
                <span class="cal-gap__label">Free</span>
                <span class="cal-gap__time"><%= from.strftime("%H:%M") %>–<%= to.strftime("%H:%M") %></span>
              <% end %>
            <% end %>

            <% room_appointments.each do |appointment| %>
              <% position = calendar_position(appointment.starts_at, appointment.ends_at, @date) %>
              <%= render "appointment", appointment: appointment, style: position, show_room: false if position %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
