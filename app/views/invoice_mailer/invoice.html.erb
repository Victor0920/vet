<%# HTML email sent by InvoiceMailer#invoice, wrapped in layouts/mailer.html.erb.
    Inline styles (like passwords_mailer/reset) because many email apps ignore <style>.
    The PDF itself travels as an attachment. %>
<% issuer = @invoice.enterprise.legal_name.presence || @invoice.enterprise.name %>

<h1 style="margin: 0 0 8px; font-size: 20px; font-weight: 600; line-height: 1.3; color: #0f172a;">
  <%= t(".heading", number: @number) %>
</h1>

<p style="margin: 0 0 24px;">
  <% if @invoice.customer %>
    <%= t(".greeting", name: @invoice.customer.first_name.presence || @invoice.customer.full_name) %>
  <% else %>
    <%= t(".greeting_anonymous") %>
  <% end %>
  <%= t(".intro", name: issuer) %>
</p>

<% if @message.present? %>
  <%# simple_format keeps the line breaks typed in the popup, and escapes the text %>
  <div style="margin: 0 0 24px; padding: 12px 16px; border-left: 3px solid #0d9488; background-color: #f8fafc; color: #334155;">
    <%= simple_format(@message, {}, wrapper_tag: "p") %>
  </div>
<% end %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 24px; border-collapse: collapse;">
  <tr>
    <td style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; color: #64748b;"><%= t(".number") %></td>
    <td align="right" style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; color: #0f172a;"><%= @number %></td>
  </tr>
  <tr>
    <td style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; color: #64748b;"><%= t(".date") %></td>
    <td align="right" style="padding: 8px 0; border-bottom: 1px solid #e2e8f0; color: #0f172a;"><%= @invoice.date ? l(@invoice.date.to_date, format: :display) : "—" %></td>
  </tr>
  <tr>
    <td style="padding: 8px 0; font-weight: 600; color: #0f172a;"><%= t(".total") %></td>
    <td align="right" style="padding: 8px 0; font-size: 18px; font-weight: 600; color: #0f172a;"><%= number_to_currency(@invoice.total, unit: "€", format: "%n %u") %></td>
  </tr>
</table>

<p style="margin: 0 0 24px;">
  <%= t(".attached") %>
</p>

<p style="margin: 0; color: #64748b;">
  <%= t(".signature", name: issuer) %>
</p>
