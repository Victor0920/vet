<% content_for :title, t(".title") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title">
      <%= t(".heading") %>
      <span class="badge badge--warning settings-admin-badge"><%= t(".admin_only") %></span>
    </h1>
    <p class="page-header__subtitle"><%= t(".subtitle") %></p>
  </div>
</div>

<%# The admin control area, like a phone's settings: one card per part of the business, each a list
    of compact rows (settings/_item), and the cards two by two. A row without path: shows "Coming soon";
    give it the route helper once that area exists %>
<div class="settings-groups">
  <section class="settings-group" aria-labelledby="settings-business">
    <h2 class="settings-group__title" id="settings-business"><%= t(".groups.business") %></h2>
    <ul class="card settings-group__list">
      <%= render "settings/item", icon: "building_office", path: enterprise_path,
            title: t(".items.enterprise.title"), description: t(".items.enterprise.description") %>
      <%= render "settings/item", icon: "building_storefront", path: stores_path,
            title: t(".items.stores.title"), description: t(".items.stores.description") %>
    </ul>
  </section>

  <section class="settings-group" aria-labelledby="settings-team">
    <h2 class="settings-group__title" id="settings-team"><%= t(".groups.team") %></h2>
    <ul class="card settings-group__list">
      <%= render "settings/item", icon: "customers", path: employees_path,
            title: t(".items.employees.title"), description: t(".items.employees.description") %>
      <%= render "settings/item", icon: "key", path: access_path,
            title: t(".items.access.title"), description: t(".items.access.description") %>
    </ul>
  </section>

  <section class="settings-group" aria-labelledby="settings-catalogue">
    <h2 class="settings-group__title" id="settings-catalogue"><%= t(".groups.catalogue") %></h2>
    <ul class="card settings-group__list">
      <%= render "settings/item", icon: "tag", path: product_categories_path(return_to: settings_path),
            title: t(".items.product_categories.title"), description: t(".items.product_categories.description") %>
      <%= render "settings/item", icon: "tag", path: service_categories_path(return_to: settings_path),
            title: t(".items.service_categories.title"), description: t(".items.service_categories.description") %>
    </ul>
  </section>

  <%# The calendar's visible hours and the default appointment length (CalendarSettingsController).
      Each store's weekly opening hours live on the store's page %>
  <section class="settings-group" aria-labelledby="settings-appointments">
    <h2 class="settings-group__title" id="settings-appointments"><%= t(".groups.appointments") %></h2>
    <ul class="card settings-group__list">
      <%= render "settings/item", icon: "calendar", path: calendar_settings_path,
            title: t(".items.calendar.title"), description: t(".items.calendar.description") %>
    </ul>
  </section>

  <%# Everything about invoices: numbering and how the PDF looks (InvoiceSettingsController) %>
  <section class="settings-group" aria-labelledby="settings-billing">
    <h2 class="settings-group__title" id="settings-billing"><%= t(".groups.billing") %></h2>
    <ul class="card settings-group__list">
      <%= render "settings/item", icon: "document_text", path: invoice_settings_path,
            title: t(".items.invoicing.title"), description: t(".items.invoicing.description") %>
    </ul>
  </section>

  <%# Channels for talking to customers (WhatsApp now, maybe email/SMS later) %>
  <section class="settings-group" aria-labelledby="settings-messaging">
    <h2 class="settings-group__title" id="settings-messaging"><%= t(".groups.messaging") %></h2>
    <ul class="card settings-group__list">
      <%= render "settings/item", icon: "messages",
            title: t(".items.whatsapp.title"), description: t(".items.whatsapp.description") %>
    </ul>
  </section>

  <%# The clinic's data is theirs: export it all whenever they want (DataExportsController),
      and bring customers, pets and the catalogue in from another program (ImportsController) %>
  <section class="settings-group" aria-labelledby="settings-data">
    <h2 class="settings-group__title" id="settings-data"><%= t(".groups.data") %></h2>
    <ul class="card settings-group__list">
      <%= render "settings/item", icon: "arrow_down_tray", path: data_export_path,
            title: t(".items.export.title"), description: t(".items.export.description") %>
      <%= render "settings/item", icon: "arrow_up_tray", path: imports_path,
            title: t(".items.import.title"), description: t(".items.import.description") %>
    </ul>
  </section>
</div>
