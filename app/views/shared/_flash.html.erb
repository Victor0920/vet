<%# Floating toasts at the top of the screen (position: fixed, so the page doesn't move).
    flash_controller.js fades each one out after 5 seconds, or straight away when clicked.
    data-turbo-temporary: Turbo drops it from its page cache, so going Back doesn't show it again. %>
<% if flash.any? %>
  <div class="flash-stack" data-turbo-temporary>
    <% flash.each do |type, message| %>
      <div class="alert alert--toast <%= type.to_s == "alert" ? "alert--danger" : "alert--success" %>"
           role="<%= type.to_s == "alert" ? "alert" : "status" %>"
           title="<%= t("shared.dismiss") %>"
           data-controller="flash" data-action="click->flash#dismiss">
        <% if type.to_s == "alert" %>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
        <% else %>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"/></svg>
        <% end %>
        <span><%= message %></span>
      </div>
    <% end %>
  </div>
<% end %>
