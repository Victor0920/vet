<%# locals: (model:, attribute:, label:, value: nil, input: :text_field, choices: []) -%>
<%#
  One row of a details list: shows the value with a pencil button,
  clicking the pencil swaps it for a mini form that PATCHes just this field.

  model: what form_with gets — a record (@customer) or a nested array ([@customer, @pet])
  input: any form builder method — :text_field (default), :email_field, :date_field,
         :text_area, or :select (needs choices:)
  value: optional formatted display value (defaults to the raw attribute)

  Usage: render "shared/editable_field", model: @customer, attribute: :email, label: "Email", input: :email_field
%>
<% record = Array(model).last %>
<% display_value = value.presence || record.public_send(attribute).presence %>
<div class="field-row" data-controller="inline-edit">
  <dt class="field-row__label"><%= label %></dt>
  <dd class="field-row__value">
    <div class="field-row__display" data-inline-edit-target="display">
      <span class="<%= "text-subtle" if display_value.blank? %> <%= "field-row__text--multiline" if input == :text_area %>">
        <%= display_value || "Not set" %>
      </span>
      <button type="button" class="btn btn--ghost btn--sm btn--icon" data-action="inline-edit#edit" aria-label="Edit <%= label.downcase %>" title="Edit">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"/><path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"/></svg>
      </button>
    </div>

    <%= form_with model: model,
      class: "field-row__form",
      html: { hidden: true },
      data: { inline_edit_target: "form", action: "keydown->inline-edit#cancelOnEscape" } do |form| %>
      <% html_options = { class: { select: "select", text_area: "textarea" }.fetch(input, "input"),
                          aria: { label: label },
                          data: { inline_edit_target: "input" } } %>
      <% if input == :select %>
        <%= form.select attribute, choices, { include_blank: "—" }, html_options %>
      <% else %>
        <%= form.public_send(input, attribute, html_options) %>
      <% end %>

      <div class="field-row__actions">
        <%= form.submit "Save", class: "btn btn--primary btn--sm" %>
        <button type="button" class="btn btn--ghost btn--sm" data-action="inline-edit#cancel">Cancel</button>
      </div>
    <% end %>
  </dd>
</div>
