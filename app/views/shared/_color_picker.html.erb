<%# A row of colour swatches for a Colorable record (product/service categories).
    Each swatch is a real radio button, hidden behind a styled <label>, so it works
    without JavaScript and with the keyboard (arrow keys move between colours).
    Locals:
      f - the form builder %>

<fieldset class="color-picker">
  <legend class="sr-only"><%= f.object.class.human_attribute_name(:color) %></legend>

  <%# Blank value = no colour: the model's normalizes turns "" into nil %>
  <%= f.radio_button :color, "", checked: f.object.color.blank?, class: "color-picker__input" %>
  <%= f.label :color, value: "", title: t("shared.no_color"), class: "color-picker__swatch color-swatch" do %>
    <span class="sr-only"><%= t("shared.no_color") %></span>
  <% end %>

  <% Colorable::COLORS.each do |color| %>
    <%= f.radio_button :color, color, class: "color-picker__input" %>
    <%= f.label :color, value: color, title: t(color, scope: "shared.colors"),
          class: "color-picker__swatch color-swatch color-swatch--#{color}" do %>
      <span class="sr-only"><%= t(color, scope: "shared.colors") %></span>
    <% end %>
  <% end %>
</fieldset>
