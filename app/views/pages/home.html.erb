<% content_for :title, "Home" %>

<div class="page-header">
  <div>
    <h1 class="page-header__title">Welcome back</h1>
    <p class="page-header__subtitle">Here's where to pick up today.</p>
  </div>
</div>

<div class="quick-links">
  <%= link_to conversations_path, class: "card card--interactive quick-link" do %>
    <span class="quick-link__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z"/></svg>
    </span>
    <span>
      <span class="quick-link__title">Conversations</span>
      <p class="quick-link__description">Reply to clients on WhatsApp.</p>
    </span>
  <% end %>

  <%= link_to messages_path, class: "card card--interactive quick-link" do %>
    <span class="quick-link__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"/></svg>
    </span>
    <span>
      <span class="quick-link__title">All messages</span>
      <p class="quick-link__description">Browse every message and its delivery status.</p>
    </span>
  <% end %>
</div>

<section class="section">
  <section class="card">
    <header class="card__header">
      <div>
        <h2 class="card__title">Developer tools</h2>
        <p class="card__description">Sends a test request to <code>POST /messages</code>.</p>
      </div>
      <%= form_with url: "/messages", method: :post do |form| %>
        <%= form.button "Send test message", class: "btn btn--secondary btn--sm" %>
      <% end %>
    </header>
  </section>
</section>
