<% content_for :title, @enterprise.name.presence || t(".title") %>

<%= render "shared/back_link", path: settings_path, label: t("settings.back") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= @enterprise.name.presence || t(".title") %></h1>
    <p class="page-header__subtitle"><%= t(".subtitle") %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to edit_enterprise_path, class: "btn btn--secondary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
        /><path
          d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
        /></svg>
      <%= t(".edit") %>
    <% end %>
  </div>
</div>

<section class="card">
  <header class="card__header">
    <div>
      <h2 class="card__title"><%= t(".legal_details") %></h2>
      <p class="card__description"><%= t(".legal_details_hint") %></p>
    </div>
  </header>
  <div class="card__body">
    <dl class="details details--grid">
      <div>
        <dt><%= Enterprise.human_attribute_name(:name) %></dt>
        <dd><%= @enterprise.name.presence || "—" %></dd>
      </div>
      <div>
        <dt><%= Enterprise.human_attribute_name(:legal_name) %></dt>
        <dd><%= @enterprise.legal_name.presence || "—" %></dd>
      </div>
      <div>
        <dt><%= Enterprise.human_attribute_name(:cif) %></dt>
        <dd><%= @enterprise.cif.presence || "—" %></dd>
      </div>
      <div>
        <dt><%= Enterprise.human_attribute_name(:address) %></dt>
        <dd><%= @enterprise.address.presence || "—" %></dd>
      </div>
      <div>
        <dt><%= t(".registered") %></dt>
        <dd><%= l(@enterprise.created_at, format: :display) %></dd>
      </div>
    </dl>
  </div>
</section>

<header class="customer-profile__section-header customer-profile__section-header--spaced">
  <div>
    <h2 class="section__title"><%= t(".stores") %></h2>
    <p class="text-muted"><%= t("stores.index.count", count: @enterprise.stores.size) %></p>
  </div>
  <%= link_to t(".manage_stores"), stores_path, class: "btn btn--ghost" %>
</header>

<% if @enterprise.stores.any? %>
  <ul class="rooms-list">
    <% @enterprise.stores.each do |store| %>
      <li>
        <%= link_to store_path(store), class: "card card--interactive rooms-list__item" do %>
          <span class="rooms-list__icon"><%= render "shared/icons/building_storefront" %></span>
          <span class="rooms-list__text">
            <span class="rooms-list__name"><%= store.name.presence || t("stores.unnamed") %></span>
            <span class="text-subtle text-xs"><%= [store.address, store.post_code].compact_blank.join(", ") %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">
    <%= render "shared/icons/building_storefront" %>
    <p class="empty-state__title"><%= t("stores.index.empty") %></p>
  </div>
<% end %>
