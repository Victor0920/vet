<%# Shared by rooms/new and /edit. Locals: store, room, title (the page heading) %>
<%# [store, room] builds the nested URL. A new room (not saved yet) posts to
    POST /settings/stores/:store_id/rooms (create); an existing one to
    PATCH /settings/stores/:store_id/rooms/:id (update) %>
<%= form_with model: [store, room] do |f| %>
  <div class="resource-form__toolbar">
    <%= render "shared/back_link", path: store_path(store), label: t("rooms.form.back_to", store: store.name.presence || t("stores.unnamed")) %>

    <div class="page-header__actions">
      <%= link_to t("shared.cancel"), store_path(store), class: "btn btn--ghost" %>
      <%= f.submit (room.persisted? ? t("shared.save_changes") : t("rooms.form.create")), class: "btn btn--primary" %>
    </div>
  </div>

  <div class="resource-form stack">
    <h1 class="page-header__title"><%= title %></h1>

    <% if room.errors.any? %>
      <div class="alert alert--danger" role="alert">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
        <ul class="form-errors">
          <% room.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="card">
      <header class="card__header">
        <h2 class="card__title"><%= t("rooms.form.details") %></h2>
      </header>
      <dl class="field-list">
        <div class="field-row">
          <dt class="field-row__label"><%= f.label :name %></dt>
          <dd class="field-row__value">
            <%= f.text_field :name, class: "input", required: true, autofocus: true,
                  aria: { invalid: room.errors[:name].any? } %>
          </dd>
        </div>
        <div class="field-row">
          <dt class="field-row__label"><%= Room.human_attribute_name(:color) %></dt>
          <dd class="field-row__value">
            <%= render "shared/color_picker", f: f, placeholder: t("rooms.form.name_placeholder") %>
          </dd>
        </div>
      </dl>
    </section>
  </div>
<% end %>
