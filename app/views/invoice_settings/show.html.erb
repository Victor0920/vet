<% content_for :title, t(".title") %>

<%= render "shared/back_link", path: settings_path, label: t("settings.back") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= t(".title") %></h1>
    <p class="page-header__subtitle"><%= t(".subtitle") %></p>
  </div>
  <div class="page-header__actions">
    <%# A PDF, not a page: data-turbo="false" so Turbo doesn't try to load it into this tab %>
    <%= link_to preview_invoice_settings_path, class: "btn btn--secondary", target: "_blank", data: { turbo: false } do %>
      <%= render "shared/icons/document_text" %>
      <%= t(".preview") %>
    <% end %>
    <%= link_to edit_invoice_settings_path, class: "btn btn--primary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
        /><path
          d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
        /></svg>
      <%= t(".edit") %>
    <% end %>
  </div>
</div>

<div class="stack">
  <section class="card">
    <header class="card__header">
      <div>
        <h2 class="card__title"><%= t(".design") %></h2>
        <p class="card__description"><%= t(".design_hint") %></p>
      </div>
    </header>
    <%# --invoice-accent: the PDF's own shade (Enterprise::INVOICE_COLORS), so the drawing matches the PDF %>
    <div class="card__body invoice-design-summary"
         style="--invoice-accent: #<%= Enterprise::INVOICE_COLORS.fetch(@enterprise.invoice_color, "0F766E") %>">
      <%= render "mockup", layout: @enterprise.invoice_layout %>

      <dl class="details details--grid">
        <div>
          <dt><%= Enterprise.human_attribute_name(:invoice_layout) %></dt>
          <dd><%= t("invoice_settings.layouts.#{@enterprise.invoice_layout}.name") %></dd>
        </div>
        <div>
          <dt><%= Enterprise.human_attribute_name(:invoice_color) %></dt>
          <dd class="invoice-color-value">
            <span class="invoice-color-dot"></span>
            <%= t(@enterprise.invoice_color, scope: "shared.colors") %>
          </dd>
        </div>
        <div>
          <dt><%= Enterprise.human_attribute_name(:logo) %></dt>
          <dd>
            <% if @enterprise.logo.attached? %>
              <%= image_tag @enterprise.logo.variant(:thumb), alt: t(".logo_alt"), class: "invoice-logo" %>
            <% else %>
              <span class="text-subtle"><%= t(".no_logo") %></span>
            <% end %>
          </dd>
        </div>
        <div class="details__wide">
          <dt><%= Enterprise.human_attribute_name(:invoice_footer) %></dt>
          <dd>
            <% if @enterprise.invoice_footer.present? %>
              <span class="invoice-footer-value"><%= @enterprise.invoice_footer %></span>
            <% else %>
              <span class="text-subtle"><%= t(".no_footer") %></span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="card">
    <header class="card__header">
      <div>
        <h2 class="card__title"><%= t(".numbering") %></h2>
        <p class="card__description"><%= t(".numbering_hint") %></p>
      </div>
    </header>
    <div class="card__body">
      <dl class="details details--grid">
        <div>
          <dt><%= Enterprise.human_attribute_name(:invoice_number_schema) %></dt>
          <dd><code><%= @enterprise.invoice_number_schema %></code></dd>
        </div>
        <div>
          <dt><%= Enterprise.human_attribute_name(:rectification_number_schema) %></dt>
          <dd>
            <% if @enterprise.rectification_number_schema.present? %>
              <code><%= @enterprise.rectification_number_schema %></code>
            <% else %>
              <%# Same fallback as InvoiceNumber#schema %>
              <code>R<%= @enterprise.invoice_number_schema %></code>
              <span class="text-subtle"><%= t(".default_rectification_schema") %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt><%= Enterprise.human_attribute_name(:invoice_counter_reset) %></dt>
          <dd><%= t("enterprises.invoice_counter_resets.#{@enterprise.invoice_counter_reset}") %></dd>
        </div>
      </dl>
    </div>
  </section>
</div>
