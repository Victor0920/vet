<% content_for :title, t(".title") %>

<%= render "shared/back_link", path: settings_path, label: t("settings.back") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= t(".title") %></h1>
    <p class="page-header__subtitle"><%= t(".subtitle") %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to edit_calendar_settings_path, class: "btn btn--primary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
        /><path
          d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
        /></svg>
      <%= t(".edit") %>
    <% end %>
  </div>
</div>

<div class="stack">
  <section class="card">
    <header class="card__header">
      <div>
        <h2 class="card__title"><%= t(".calendar") %></h2>
        <p class="card__description"><%= t(".calendar_hint") %></p>
      </div>
    </header>
    <div class="card__body">
      <dl class="details details--grid">
        <div>
          <dt><%= t(".visible_hours") %></dt>
          <dd><%= @enterprise.calendar_opens_at %> – <%= @enterprise.calendar_closes_at %></dd>
        </div>
        <div>
          <dt><%= Enterprise.human_attribute_name(:default_appointment_minutes) %></dt>
          <dd><%= t(".minutes", count: @enterprise.default_appointment_minutes) %></dd>
        </div>
      </dl>
    </div>
  </section>

  <%# The weekly opening hours belong to each store, so they're edited on the store's page %>
  <section class="card">
    <header class="card__header">
      <div>
        <h2 class="card__title"><%= t(".opening_hours") %></h2>
        <p class="card__description"><%= t(".opening_hours_hint") %></p>
      </div>
      <%= link_to t(".manage_stores"), stores_path, class: "btn btn--secondary btn--sm" %>
    </header>
  </section>
</div>
