<% content_for :title, "Sign in" %>

<div class="card auth-card">
  <div class="auth-card__header">
    <h1 class="auth-card__title">Sign in to Vet</h1>
    <p class="auth-card__subtitle">Welcome back! Enter your details below.</p>
  </div>

  <%= form_with url: session_path, class: "form" do |form| %>
    <div class="form-field">
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@clinic.com", value: params[:email_address], class: "input" %>
    </div>

    <div class="form-field">
      <div class="label-row">
        <%= form.label :password, class: "label" %>
        <%= link_to "Forgot password?", new_password_path %>
      </div>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Sign in", class: "btn btn--primary btn--block btn--lg" %>
  <% end %>
</div>
