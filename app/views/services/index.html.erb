<% content_for :title, t(".title") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= t(".heading") %></h1>
    <p class="page-header__subtitle"><%= t(".subtitle") %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to t(".categories"), service_categories_path, class: "btn btn--secondary" %>
    <%= link_to new_service_path, class: "btn btn--primary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"
        /></svg>
      <%= t(".new_service") %>
    <% end %>
  </div>
</div>

<%# Same pattern as products#index: typing or picking a category submits the form
    (debounced by search_controller.js) into the "services" frame, so only the table
    is replaced. Both params end up in the URL: /services?q=…&category_id=… %>
<%= form_with url: services_path, method: :get, role: "search", class: "products-filters",
    data: { controller: "search", turbo_frame: "services", turbo_action: "replace" } do %>
  <div class="search-field products-filters__search">
    <%= render "shared/icons/magnifying_glass" %>
    <%= label_tag :q, t(".search_label"), class: "sr-only" %>
    <%= search_field_tag :q, @query,
          class: "input",
          placeholder: t(".search_placeholder"),
          autocomplete: "off",
          data: { action: "input->search#submit" } %>
  </div>

  <%# item_picker_controller.js (same as the invoice lines) turns the select into a dropdown
      with "All categories" on top and a search box for the categories below it %>
  <div class="item-picker products-filters__category" data-controller="item-picker"
       data-item-picker-placeholder-value="<%= t(".search_categories") %>"
       data-item-picker-empty-value="<%= t(".no_categories_match") %>">
    <%= label_tag :category_id, t(".category"), class: "sr-only" %>
    <%= select_tag :category_id,
          options_from_collection_for_select(@categories, :id, :name, @category_id),
          include_blank: t(".all_categories"),
          class: "select",
          data: { action: "change->search#submit", item_picker_target: "select" } %>
  </div>
<% end %>

<%# target: "_top" so links inside (service names) open the full page, not the frame %>
<%= turbo_frame_tag "services", target: "_top" do %>
  <p class="products-filters__count">
    <% if @query.present? %>
      <%= t(".count_matching", count: @services.size, query: @query) %>
    <% else %>
      <%= t(".count", count: @services.size) %>
    <% end %>
  </p>

  <% if @services.any? %>
    <div class="table-wrapper">
      <table class="table">
        <thead>
          <tr>
            <th><%= t("services.columns.id") %></th>
            <th><%= t("services.columns.service") %></th>
            <th><%= t("services.columns.category") %></th>
            <th class="products-table__price"><%= t("services.columns.price") %></th>
          </tr>
        </thead>
        <tbody>
          <% @services.each do |service| %>
            <tr>
              <td class="table__numeric">#<%= service.id %></td>
              <td>
                <div class="product-cell">
                  <%= link_to service.name.presence || t("services.unnamed"), service_path(service),
                        class: "product-cell__name" %>
                  <% if service.description.present? %>
                    <span class="product-cell__meta"><%= service.description %></span>
                  <% end %>
                </div>
              </td>
              <td>
                <%= link_to service.service_category.name.presence || t("shared.unnamed"),
                      service_category_path(service.service_category),
                      class: "badge badge--primary" %>
              </td>
              <td class="table__numeric products-table__price">
                <%= service.price ? number_to_currency(service.price, unit: "€", format: "%n %u") : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% elsif @query.present? || @category_id.present? %>
    <div class="empty-state">
      <%= render "shared/icons/magnifying_glass" %>
      <p class="empty-state__title"><%= t(".no_matches") %></p>
      <p><%= t(".no_matches_hint") %></p>
    </div>
  <% else %>
    <div class="empty-state">
      <%= render "shared/paw_icon" %>
      <p class="empty-state__title"><%= t(".empty") %></p>
      <p><%= t(".empty_hint") %></p>
    </div>
  <% end %>
<% end %>
