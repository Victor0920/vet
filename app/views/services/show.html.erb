<% content_for :title,
@service.name.presence || t("services.number", id: @service.id) %>

<%= render "shared/back_link", path: services_path, label: t("services.all_services") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= @service.name.presence || t("services.unnamed") %></h1>
    <p class="page-header__subtitle"><%= t("services.number", id: @service.id) %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to edit_service_path(@service), class: "btn btn--secondary" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
        /><path
          d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
        /></svg>
      <%= t(".edit_service") %>
    <% end %>
    <%# Admins only. Services are never deleted, only archived: that hides them from lists
        and new invoices but keeps old invoices (legal records) intact %>
    <% if admin? %>
      <% if @service.archived? %>
        <%= button_to service_archive_path(@service), method: :delete, class: "btn btn--secondary" do %>
          <%= render "shared/icons/archive_box" %>
          <%= t(".unarchive") %>
        <% end %>
      <% else %>
        <%= button_to service_archive_path(@service), class: "btn btn--secondary" do %>
          <%= render "shared/icons/archive_box" %>
          <%= t(".archive") %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>

<% if @service.archived? %>
  <div class="alert alert--warning archived-notice" role="status">
    <%= t(".archived_notice", date: l(@service.archived_at.to_date, format: :long)) %>
  </div>
<% end %>

<section class="card product-card">
  <div class="card__body">
    <dl class="details details--grid">
      <div>
        <dt><%= Service.human_attribute_name(:service_category) %></dt>
        <dd>
          <%= render "shared/category_badge", category: @service.service_category %>
        </dd>
      </div>
      <%# What the customer pays first, then how it splits: price without VAT + VAT % %>
      <div>
        <dt><%= t("services.columns.price") %></dt>
        <dd><%= @service.price ? number_to_currency(@service.price_with_vat, unit: "€", format: "%n %u") : "—" %></dd>
      </div>
      <div>
        <dt><%= Service.human_attribute_name(:price) %></dt>
        <dd>
          <%= @service.price ? number_to_currency(@service.price, unit: "€", format: "%n %u") : "—" %>
          <span class="text-muted">· <%= Service.human_attribute_name(:vat_rate) %>
            <%= number_to_percentage(@service.vat_rate, precision: 2, strip_insignificant_zeros: true) %></span>
        </dd>
      </div>
      <div>
        <dt><%= t(".created") %></dt>
        <dd><%= l(@service.created_at, format: :display) %></dd>
      </div>
      <div>
        <dt><%= t("shared.last_updated") %></dt>
        <dd>
          <%# updated_by is empty for rows changed before it existed, or from the console %>
          <% if @service.updated_by %>
            <%= t(
              "shared.time_ago_by",
              time: time_ago_in_words(@service.updated_at),
              name: @service.updated_by.display_name,
            ) %>
          <% else %>
            <%= t("shared.time_ago", time: time_ago_in_words(@service.updated_at)) %>
          <% end %>
        </dd>
      </div>
      <div class="details__wide">
        <dt><%= Service.human_attribute_name(:description) %></dt>
        <dd><%= @service.description.presence || "—" %></dd>
      </div>
    </dl>
  </div>
</section>
