<% content_for :title, t("invoices.number", id: @invoice.display_number) %>

<%= render "shared/back_link", path: invoices_path, label: t("invoices.all_invoices") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= t("invoices.number", id: @invoice.display_number) %></h1>
    <p class="page-header__subtitle">
      <% if @invoice.corrective? %>
        <span class="badge badge--warning"><%= t("invoices.rectificativa") %></span>
      <% end %>
      <%= @invoice.date ? l(@invoice.date, format: :full) : "—" %>
    </p>
  </div>
  <div class="invoice-total">
    <span class="invoice-total__label"><%= t("invoices.columns.total") %></span>
    <span class="invoice-total__amount"><%= number_to_currency(@invoice.total, unit: "€", format: "%n %u") %></span>
  </div>
  <div class="page-header__actions">
    <%# Loads invoices/emails/new into the "modal" frame at the bottom of this page %>
    <%= link_to new_invoice_email_path(@invoice), class: "btn btn--secondary", data: { turbo_frame: "modal" } do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M3 4a2 2 0 0 0-2 2v1.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 7.162V6a2 2 0 0 0-2-2H3Z"/><path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z"/></svg>
      <%= t(".send_email") %>
    <% end %>
    <%# /invoices/:id.pdf → the same show action answers with a PDF (format.pdf).
        turbo: false makes it a normal browser download instead of a Turbo page visit. %>
    <%= link_to invoice_path(@invoice, format: :pdf), class: "btn btn--secondary", data: { turbo: false } do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z"/><path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"/></svg>
      <%= t(".download_pdf") %>
    <% end %>
    <%# A rectificativa can't be rectified again (Invoices::RectificationsController refuses it too) %>
    <% unless @invoice.corrective? %>
      <%= link_to new_invoice_rectification_path(@invoice), class: "btn btn--secondary" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.793 2.232a.75.75 0 0 1-.025 1.06L3.622 7.25h10.003a5.375 5.375 0 0 1 0 10.75H10.75a.75.75 0 0 1 0-1.5h2.875a3.875 3.875 0 0 0 0-7.75H3.622l4.146 3.957a.75.75 0 0 1-1.036 1.085l-5.5-5.25a.75.75 0 0 1 0-1.085l5.5-5.25a.75.75 0 0 1 1.06.025Z" clip-rule="evenodd"/></svg>
        <%= t(".create_rectification") %>
      <% end %>
    <% end %>
    <%# Locked = a rectificativa, or an invoice that already has one (Invoice#locked?).
        InvoicesController#forbid_editing_locked_invoices refuses the edit URL too. %>
    <% unless @invoice.locked? %>
      <%= link_to edit_invoice_path(@invoice), class: "btn btn--secondary" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
            d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
          /><path
            d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
          /></svg>
        <%= t(".edit_invoice") %>
      <% end %>
    <% end %>
  </div>
</div>

<div class="invoice-page stack">
  <section class="card">
    <div class="card__body">
      <dl class="details details--grid">
        <div>
          <dt><%= Invoice.human_attribute_name(:customer) %></dt>
          <dd>
            <% if @invoice.customer %>
              <%= link_to @invoice.customer.full_name, customer_path(@invoice.customer, return_to: request.fullpath) %>
            <% else %>
              <span class="text-subtle"><%= t("invoices.no_customer") %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt><%= Invoice.human_attribute_name(:appointment) %></dt>
          <dd>
            <% if @invoice.appointment %>
              <%# Opens the calendar on that day; the appointment can be edited from there %>
              <%= link_to appointments_path(view: "day", date: @invoice.appointment.starts_at.to_date, store_id: @invoice.appointment.store_id) do %>
                <%= @invoice.appointment.title.presence || t("shared.untitled") %>
                · <%= l(@invoice.appointment.starts_at, format: :short_datetime) %>
              <% end %>
            <% else %>
              <span class="text-subtle"><%= t(".no_appointment") %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt><%= Invoice.human_attribute_name(:employee) %></dt>
          <dd><%= @invoice.employee.display_name %></dd>
        </div>
        <div>
          <dt><%= Invoice.human_attribute_name(:store) %></dt>
          <dd><%= @invoice.store.name %></dd>
        </div>
        <% if @invoice.original_invoice %>
          <div>
            <dt><%= Invoice.human_attribute_name(:original_invoice) %></dt>
            <dd>
              <%= link_to t("invoices.number", id: @invoice.original_invoice.display_number),
                    invoice_path(@invoice.original_invoice) %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <section class="card">
    <header class="card__header">
      <h2 class="card__title"><%= t(".lines") %></h2>
    </header>
    <% if @invoice.invoice_products.any? %>
      <div class="table-wrapper">
        <table class="table">
          <thead>
            <tr>
              <th><%= t("invoices.columns.product") %></th>
              <th class="invoices-table__total"><%= t("invoices.columns.quantity") %></th>
              <th class="invoices-table__total"><%= t("invoices.columns.unit_price") %></th>
              <th class="invoices-table__total"><%= t("invoices.columns.subtotal") %></th>
            </tr>
          </thead>
          <tbody>
            <% @invoice.invoice_products.each do |line| %>
              <tr>
                <td>
                  <div class="product-cell">
                    <% if line.product %>
                      <%= link_to line.product.name.presence || t("products.unnamed"), product_path(line.product),
                            class: "product-cell__name" %>
                    <% elsif line.service %>
                      <span class="product-cell__name">
                        <%= link_to line.service.name.presence || t("services.unnamed"), service_path(line.service) %>
                        <span class="badge badge--primary"><%= t(".service") %></span>
                      </span>
                    <% else %>
                      <span class="product-cell__name">
                        <%= line.description %>
                        <span class="badge badge--info"><%= t(".custom_item") %></span>
                      </span>
                    <% end %>
                  </div>
                </td>
                <td class="table__numeric invoices-table__total"><%= line.quantity %></td>
                <td class="table__numeric invoices-table__total">
                  <%# The price saved on the line, so later product/service price changes don't alter old invoices %>
                  <%= line.price ? number_to_currency(line.price, unit: "€", format: "%n %u") : "—" %>
                </td>
                <td class="table__numeric invoices-table__total">
                  <%= number_to_currency(line.subtotal, unit: "€", format: "%n %u") %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="invoices-table__footer">
              <th colspan="3" scope="row"><%= t("invoices.columns.total") %></th>
              <td class="table__numeric invoices-table__total">
                <%= number_to_currency(@invoice.total, unit: "€", format: "%n %u") %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <%= render "shared/icons/shopping_bag" %>
        <p class="empty-state__title"><%= t(".no_lines") %></p>
        <p><%= t(".no_lines_hint") %></p>
      </div>
    <% end %>
  </section>

  <%# Refunds and corrections made on this invoice. Reuses the index table (same columns,
      minus the customer, which is always this invoice's). %>
  <% if @invoice.corrective_invoices.any? %>
    <section>
      <h2 class="card__title"><%= t(".rectifications") %></h2>
      <p class="form-hint invoice-page__section-hint"><%= t(".rectified_hint") %></p>
      <%= render "table", invoices: @invoice.corrective_invoices, show_customer: false %>
    </section>
  <% end %>
</div>

<%# Popups (e.g. "Send by email") load into this frame %>
<%= turbo_frame_tag "modal" %>
