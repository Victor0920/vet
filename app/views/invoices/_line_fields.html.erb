<%# One invoice line (invoice_product) inside invoices/_form. `line` is the fields_for builder,
    so every input is named invoice[invoice_products_attributes][<index>][…].
    A line is a product or a service (pick it in the select) or a custom item
    (leave the select on "Custom item" and type a description and price).
    The select sends `item` ("product-5", "service-3" or ""), a virtual attribute
    that InvoiceProduct#item= splits into product_id / service_id.
    invoice_lines_controller.js shows the right fields and handles add/remove. %>
<% item = line.object %>
<%# A saved line that already took units out of stock "holds" them: when editing, it may use
    the product's stock plus those units. The JS adds them back when computing the max.
    data-saved-item uses the same "product-5" format as the select's values, so the JS can compare them. %>
<% holds_stock = item.persisted? && item.invoice.updates_stock_in_database && item.product_id_in_database %>
<div class="invoice-line" data-invoice-lines-target="line"
     data-saved-item="<%= "product-#{item.product_id_in_database}" if holds_stock %>"
     data-saved-quantity="<%= item.quantity_in_database if holds_stock %>">
  <%# id tells Rails which saved line to update; _destroy=1 (set by the ✕ button) deletes it %>
  <%= line.hidden_field :id %>
  <%= line.hidden_field :_destroy %>

  <%# item_picker_controller.js hides this select and shows a searchable dropdown instead:
      "Custom item", then a search box, then the Products and Services groups.
      The select is still what the form submits. %>
  <div class="invoice-line__product item-picker" data-controller="item-picker"
       data-item-picker-placeholder-value="<%= t("invoices.line_fields.search_placeholder") %>"
       data-item-picker-empty-value="<%= t("invoices.line_fields.no_matches") %>">
    <%= line.label :item, InvoiceProduct.human_attribute_name(:item), class: "sr-only" %>
    <%# Grouped choices ([label, [options]]) render as <optgroup>s. Only products carry
        data-stock: services have none, so the JS shows no "available" count for them. %>
    <%= line.select :item,
          [
            [t("invoices.line_fields.products_group"), @products.map { |product|
              [product.name.presence || t("products.unnamed"), "product-#{product.id}",
               { data: { price: product.price ? number_to_currency(product.price, unit: "€", format: "%n %u") : "",
                         stock: product.stock } }]
            }],
            [t("invoices.line_fields.services_group"), @services.map { |service|
              [service.name.presence || t("services.unnamed"), "service-#{service.id}",
               { data: { price: service.price ? number_to_currency(service.price, unit: "€", format: "%n %u") : "" } }]
            }]
          ].reject { |_label, options| options.empty? },
          { include_blank: t("invoices.line_fields.custom_item") },
          class: "select",
          data: { action: "change->invoice-lines#toggle", item_select: true, item_picker_target: "select" },
          aria: { invalid: item.errors[:product].any? || item.errors[:service].any? } %>
  </div>

  <div class="invoice-line__detail">
    <%# Shown when a product or service is picked: the price comes from it %>
    <p class="invoice-line__product-price" data-product-price hidden>
      <span data-product-price-value></span>
      <span class="text-subtle"><%= t("invoices.line_fields.per_unit") %></span>
      <%# "· 5 available", filled in by the JS while "Update stock" is on %>
      <span class="invoice-line__stock" data-product-stock hidden></span>
    </p>

    <%# Shown for custom items; disabled (so not submitted) when a product or service is picked %>
    <div class="invoice-line__manual" data-manual>
      <%= line.label :description, InvoiceProduct.human_attribute_name(:description), class: "sr-only" %>
      <%= line.text_field :description, class: "input", required: true,
            placeholder: t("invoices.line_fields.description_placeholder"),
            aria: { invalid: item.errors[:description].any? } %>
      <%= line.label :price, InvoiceProduct.human_attribute_name(:price), class: "sr-only" %>
      <%= line.number_field :price, class: "input invoice-line__price", required: true,
            step: 0.01, min: 0, placeholder: t("invoices.line_fields.price_placeholder"),
            aria: { invalid: item.errors[:price].any? } %>
    </div>
  </div>

  <div class="invoice-line__quantity">
    <%= line.label :quantity, InvoiceProduct.human_attribute_name(:quantity), class: "sr-only" %>
    <%= line.number_field :quantity, class: "input", required: true, min: 1, step: 1,
          aria: { invalid: item.errors[:quantity].any? } %>
  </div>

  <button type="button" class="btn btn--ghost btn--icon btn--sm"
          data-action="invoice-lines#remove"
          aria-label="<%= t("invoices.line_fields.remove") %>">
    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
  </button>
</div>
