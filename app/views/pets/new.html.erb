<% owner_name = [@customer.first_name, @customer.first_surname].compact_blank.join(" ").presence || "Customer ##{@customer.id}" %>
<% content_for :title, "New pet" %>

<%# Same layout as pets/edit, but with plain inputs instead of shared/editable_field,
    all inside one form that is saved with the button in the top right corner. %>
<%= form_with model: [@customer, @pet] do |f| %>
  <div class="customer-form__toolbar">
    <%= link_to customer_path(@customer), class: "back-link" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"/></svg>
      Back to <%= owner_name %>
    <% end %>

    <div class="page-header__actions">
      <%= link_to "Cancel", customer_path(@customer), class: "btn btn--ghost" %>
      <%= f.submit "Create pet", class: "btn btn--primary" %>
    </div>
  </div>

  <div class="customer-profile">
    <aside class="card customer-profile__sidebar">
      <%# The photo is a <label> for the hidden file input; image-preview shows the picked photo
          before the form is saved (nothing is uploaded until "Create pet"). %>
      <div class="pet-photo" data-controller="image-preview">
        <%= f.label :photo, class: "pet-photo__trigger" do %>
          <img alt="" class="pet-photo__image" hidden data-image-preview-target="image">
          <span class="pet-photo__placeholder" data-image-preview-target="placeholder"><%= render "shared/paw_icon" %></span>
          <span class="pet-photo__overlay">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M1 8a2 2 0 0 1 2-2h.93a2 2 0 0 0 1.664-.89l.812-1.22A2 2 0 0 1 8.07 3h3.86a2 2 0 0 1 1.664.89l.812 1.22A2 2 0 0 0 16.07 6H17a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8Zm13.5 3a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM10 14a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/></svg>
            Add photo
          </span>
        <% end %>
        <%= f.file_field :photo, accept: "image/*", class: "sr-only", data: { action: "change->image-preview#show" } %>
      </div>

      <div class="customer-profile__header">
        <div>
          <h1 class="customer-profile__name">New pet</h1>
          <p class="text-subtle text-xs">Click the image to add a photo</p>
        </div>
      </div>

      <div class="card__body">
        <dl class="details">
          <div>
            <dt>Owner</dt>
            <dd>
              <%= link_to customer_path(@customer), class: "pet-owner" do %>
                <% if @customer.photo.attached? %>
                  <%= image_tag @customer.photo.variant(resize_to_fill: [64, 64]), alt: "", class: "avatar avatar--sm avatar--photo" %>
                <% else %>
                  <span class="avatar avatar--sm"><%= @customer.first_name.to_s.first %><%= @customer.first_surname.to_s.first %></span>
                <% end %>
                <%= owner_name %>
              <% end %>
            </dd>
          </div>
        </dl>
      </div>
    </aside>

    <div class="customer-profile__main stack">
      <% if @pet.errors.any? %>
        <div class="alert alert--danger" role="alert">
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
          <ul class="form-errors">
            <% @pet.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <section class="card">
        <header class="card__header">
          <h2 class="card__title">General</h2>
        </header>
        <dl class="field-list">
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :name %></dt>
            <dd class="field-row__value">
              <%= f.text_field :name, class: "input", required: true, autofocus: true,
                    aria: { invalid: @pet.errors[:name].any? } %>
            </dd>
          </div>
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :species %></dt>
            <dd class="field-row__value"><%= f.text_field :species, class: "input" %></dd>
          </div>
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :breed %></dt>
            <dd class="field-row__value"><%= f.text_field :breed, class: "input" %></dd>
          </div>
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :sex %></dt>
            <dd class="field-row__value">
              <%= f.select :sex, ["Male", "Female"], { include_blank: "—" }, class: "select" %>
            </dd>
          </div>
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :born_on, "Born" %></dt>
            <dd class="field-row__value"><%= f.date_field :born_on, class: "input" %></dd>
          </div>
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :color %></dt>
            <dd class="field-row__value"><%= f.text_field :color, class: "input" %></dd>
          </div>
        </dl>
      </section>

      <section class="card">
        <header class="card__header">
          <h2 class="card__title">Identification</h2>
        </header>
        <dl class="field-list">
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :transponder_number, "Microchip number" %></dt>
            <dd class="field-row__value"><%= f.text_field :transponder_number, class: "input" %></dd>
          </div>
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :transponder_location, "Microchip location" %></dt>
            <dd class="field-row__value"><%= f.text_field :transponder_location, class: "input" %></dd>
          </div>
        </dl>
      </section>

      <section class="card">
        <header class="card__header">
          <h2 class="card__title">Notes</h2>
        </header>
        <dl class="field-list">
          <div class="field-row">
            <dt class="field-row__label"><%= f.label :notes %></dt>
            <dd class="field-row__value"><%= f.text_area :notes, class: "textarea", rows: 4 %></dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
<% end %>
