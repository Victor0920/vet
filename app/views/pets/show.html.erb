<% owner_name = [@customer.first_name, @customer.first_surname].compact_blank.join(" ").presence || t("shared.customer_number", id: @customer.id) %>
<% content_for :title, @pet.name.presence || t("shared.pet_number", id: @pet.id) %>

<%= render "shared/back_link", path: customer_path(@customer), label: owner_name %>

<div class="customer-profile">
  <aside class="card customer-profile__sidebar">
    <div class="pet-photo">
      <div class="pet-photo__frame">
        <% if @pet.photo.attached? %>
          <%= image_tag @pet.photo.variant(resize_to_fill: [576, 576]), alt: @pet.name.to_s, class: "pet-photo__image" %>
        <% else %>
          <span class="pet-photo__placeholder"><%= render "shared/paw_icon" %></span>
        <% end %>
      </div>
    </div>

    <div class="customer-profile__header">
      <div>
        <h1 class="customer-profile__name"><%= @pet.name.presence || t("shared.unnamed_pet") %></h1>
        <p class="text-subtle text-xs">
          <%= [@pet.pet_species&.display_name, @pet.breed].compact_blank.join(" · ").presence || t("shared.pet_number", id: @pet.id) %>
        </p>
      </div>
    </div>

    <div class="card__body">
      <dl class="details">
        <div>
          <dt><%= t("pets.owner") %></dt>
          <dd>
            <%= link_to customer_path(@customer), class: "pet-owner" do %>
              <% if @customer.photo.attached? %>
                <%= image_tag @customer.photo.variant(:small), alt: "", class: "avatar avatar--sm avatar--photo" %>
              <% else %>
                <span class="avatar avatar--sm"><%= @customer.first_name.to_s.first %><%= @customer.first_surname.to_s.first %></span>
              <% end %>
              <%= owner_name %>
            <% end %>
          </dd>
        </div>
        <% if (latest_weight = @weights.last) %>
          <div>
            <dt><%= t("pets.weights.latest") %></dt>
            <dd>
              <%= t("pets.weights.kg", value: number_with_precision(latest_weight.weight, precision: 2, strip_insignificant_zeros: true)) %>
              <span class="text-subtle text-xs">· <%= l(latest_weight.measured_on, format: :display) %></span>
            </dd>
          </div>
        <% end %>
        <div>
          <dt><%= t("pets.added") %></dt>
          <dd><%= l(@pet.created_at, format: :display) %></dd>
        </div>
        <div>
          <dt><%= t("shared.last_updated") %></dt>
          <dd><%= t("shared.time_ago", time: time_ago_in_words(@pet.updated_at)) %></dd>
        </div>
      </dl>
    </div>
  </aside>

  <%# Each card is a title plus a list of [label, value] pairs, rendered read-only by _details_card %>
  <% general = [
    [Pet.human_attribute_name(:name), @pet.name],
    [Pet.human_attribute_name(:pet_species), @pet.pet_species&.display_name],
    [Pet.human_attribute_name(:breed), @pet.breed],
    [Pet.human_attribute_name(:sterilized), @pet.sterilized.nil? ? nil : (@pet.sterilized ? tag.span(t("shared.yes"), class: "badge badge--success") : tag.span(t("shared.no"), class: "badge"))],
    [Pet.human_attribute_name(:sex), @pet.sex.presence && t(@pet.sex.downcase, scope: "pets.sex", default: @pet.sex)],
    [Pet.human_attribute_name(:born_on), @pet.born_on && t("pets.born_value", date: l(@pet.born_on, format: :display), age: distance_of_time_in_words(@pet.born_on, Date.current))],
    [Pet.human_attribute_name(:color), @pet.color],
    [Pet.human_attribute_name(:usual_employee), @pet.usual_employee&.display_name],
    [Pet.human_attribute_name(:transponder_number), @pet.transponder_number],
    [Pet.human_attribute_name(:transponder_location), @pet.transponder_location]
  ] %>
  <% notes = [[Pet.human_attribute_name(:notes), @pet.notes]] %>

  <div class="customer-profile__main stack">
    <%# The pet's actions, top right of the page (same place as on customers#show) %>
    <div class="customer-profile__actions customer-profile__actions--end">
      <%= link_to edit_customer_pet_path(@customer, @pet), class: "btn btn--secondary" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"/><path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"/></svg>
        <%= t(".edit_pet") %>
      <% end %>
    </div>

    <%# columns: true lays the card's fields out in two columns %>
    <%= render "details_card", title: t("pets.sections.general"), fields: general, columns: true %>
    <%= render "details_card", title: t("pets.sections.notes"), fields: notes, narrow_label: true, rich_text: true %>

    <section class="card">
      <header class="card__header">
        <h2 class="card__title"><%= t("pets.weights.title") %></h2>
        <%# Opens pets/weights/new inside the "modal" frame at the bottom of this page %>
        <%= link_to new_customer_pet_weight_path(@customer, @pet), class: "btn btn--primary btn--sm", data: { turbo_frame: "modal" } do %>
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/></svg>
          <%= t("pets.weights.add") %>
        <% end %>
      </header>

      <div class="card__body">
        <% if @weights.empty? %>
          <div class="empty-state">
            <p class="empty-state__title"><%= t("pets.weights.empty") %></p>
            <p><%= t("pets.weights.empty_hint") %></p>
          </div>
        <% else %>
          <%# One dot per weighing: date on x, kg on y. discrete: true treats the dates as plain
              labels, so the dots are evenly spaced however many days apart they were.
              Teal = --color-primary; the grey grid and labels read on both light and dark
              backgrounds (canvas can't use CSS vars) %>
          <div class="pet-weights__chart">
            <%= line_chart @weights.map { |weight| [l(weight.measured_on, format: :display), weight.weight.to_f] },
                  discrete: true, height: "240px", suffix: " kg", curve: false, colors: ["#0d9488"],
                  library: {
                    scales: {
                      x: { ticks: { color: "#64748b" }, grid: { color: "rgba(148, 163, 184, 0.2)" } },
                      y: { ticks: { color: "#64748b" }, grid: { color: "rgba(148, 163, 184, 0.2)" } }
                    }
                  } %>
          </div>

          <div class="table-wrapper pet-weights__list">
            <table class="table">
              <thead>
                <tr>
                  <th><%= PetWeight.human_attribute_name(:measured_on) %></th>
                  <th><%= PetWeight.human_attribute_name(:weight) %></th>
                  <th><%= t("pets.weights.change") %></th>
                  <th><span class="sr-only"><%= t("pets.weights.actions") %></span></th>
                </tr>
              </thead>
              <tbody>
                <%# [nil, a, b, c].each_cons(2) → (nil, a), (a, b), (b, c): each weight with the one
                    before it, so weight_change can show the difference. reverse_each = newest first %>
                <% [nil, *@weights].each_cons(2).reverse_each do |previous, weight| %>
                  <tr>
                    <td><%= l(weight.measured_on, format: :display) %></td>
                    <td class="table__numeric"><%= t("pets.weights.kg", value: number_with_precision(weight.weight, precision: 2, strip_insignificant_zeros: true)) %></td>
                    <td class="table__numeric"><%= weight_change(weight, previous) || "—" %></td>
                    <td class="pet-weights__actions">
                      <%= button_to customer_pet_weight_path(@customer, @pet, weight), method: :delete,
                            class: "btn btn--danger-ghost btn--icon btn--sm",
                            aria: { label: t("pets.weights.delete") },
                            form: { data: { turbo_confirm: t("pets.weights.delete_confirm"), confirm_button: t("shared.delete") } } do %>
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd"/></svg>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>

<%# Empty until "Add weight" loads pets/weights/new into it %>
<%= turbo_frame_tag "modal" %>
