<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light only">
    <%#
      Email clients ignore external stylesheets and strip most <style> rules,
      so every style is inline and layout uses tables (needed for Outlook).
      Colours mirror app/assets/stylesheets/variables.css.
    %>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: Inter, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #0f172a; -webkit-font-smoothing: antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f8fafc;">
      <tr>
        <td align="center" style="padding: 40px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 480px;">
            <%# Brand %>
            <tr>
              <td style="padding-bottom: 24px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="28" height="28" align="center" valign="middle" style="width: 28px; height: 28px; background-color: #0d9488; border-radius: 6px; color: #ffffff; font-size: 15px; font-weight: 700; line-height: 28px;">V</td>
                    <td style="padding-left: 8px; font-size: 16px; font-weight: 600; color: #0f172a;">Vet</td>
                  </tr>
                </table>
              </td>
            </tr>

            <%# Card %>
            <tr>
              <td style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 32px; font-size: 14px; line-height: 1.6; color: #475569;">
                <%= yield %>
              </td>
            </tr>

            <%# Footer %>
            <tr>
              <td style="padding: 24px 8px 0; font-size: 12px; line-height: 1.5; color: #64748b; text-align: center;">
                You're receiving this email because of activity on your Vet account.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
