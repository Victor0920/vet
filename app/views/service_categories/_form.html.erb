<%# Shared by service_categories/new and /edit %>
<% back_path = category.persisted? ? service_category_path(category) : service_categories_path %>

<%= form_with model: category do |f| %>
  <div class="resource-form__toolbar">
    <%= render "shared/back_link", path: back_path, label: (category.persisted? ? t(".back_to_category") : t("service_categories.all_categories")) %>

    <div class="page-header__actions">
      <%= link_to t("shared.cancel"), back_path, class: "btn btn--ghost" %>
      <%= f.submit (category.persisted? ? t("shared.save_changes") : t(".create")), class: "btn btn--primary" %>
    </div>
  </div>

  <div class="resource-form stack">
    <h1 class="page-header__title"><%= category.persisted? ? t("service_categories.edit.title", name: category.name_was.presence || t("service_categories.number", id: category.id)) : t("service_categories.new.title") %></h1>

    <% if category.errors.any? %>
      <div class="alert alert--danger" role="alert">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/></svg>
        <ul class="form-errors">
          <% category.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="card">
      <header class="card__header">
        <h2 class="card__title"><%= t("service_categories.form.details") %></h2>
      </header>
      <dl class="field-list">
        <div class="field-row">
          <dt class="field-row__label"><%= f.label :name %></dt>
          <dd class="field-row__value">
            <%= f.text_field :name, class: "input", required: true, autofocus: true,
                  aria: { invalid: category.errors[:name].any? } %>
          </dd>
        </div>
        <div class="field-row">
          <dt class="field-row__label"><%= ServiceCategory.human_attribute_name(:color) %></dt>
          <dd class="field-row__value">
            <%= render "shared/color_picker", f: f %>
          </dd>
        </div>
      </dl>
    </section>
  </div>
<% end %>
