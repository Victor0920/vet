<% full_name = [
  @customer.first_name,
  @customer.first_surname,
  @customer.second_surname,
].compact_blank.join(" ") %>
<% content_for :title, full_name.presence || t("shared.customer_number", id: @customer.id) %>

<%= render "shared/back_link", path: customers_path, label: t(".all_customers") %>

<div class="customer-profile">
  <aside class="card customer-profile__sidebar">
    <div class="customer-profile__header">
      <% if @customer.photo.attached? %>
        <%= image_tag @customer.photo.variant(resize_to_fill: [192, 192]),
        alt: full_name,
        class: "avatar avatar--xl avatar--photo" %>
      <% else %>
        <span class="avatar avatar--xl"><%= @customer.first_name.to_s.first %><%= @customer.first_surname.to_s.first %></span>
      <% end %>
      <div>
        <h1 class="customer-profile__name"><%= full_name.presence || t("shared.unnamed_customer") %></h1>
        <p class="text-subtle text-xs"><%= t("shared.customer_number", id: @customer.id) %></p>
      </div>
      <%= link_to edit_customer_path(@customer), class: "btn btn--secondary btn--sm" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
            d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"
          /><path
            d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"
          /></svg>
        <%= t(".edit_customer") %>
      <% end %>
      <%# Opens the calendar in "booking for this customer" mode (see appointments/index) %>
      <%= link_to appointments_path(customer_id: @customer.id), class: "btn btn--primary btn--sm" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2Zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75Z" clip-rule="evenodd"/></svg>
        <%= t(".new_appointment") %>
      <% end %>
    </div>

    <div class="card__body">
      <dl class="details">
        <div>
          <dt><%= Customer.human_attribute_name(:email) %></dt>
          <dd><%= @customer.email.present? ? mail_to(@customer.email) : "—" %></dd>
        </div>
        <div>
          <dt><%= Customer.human_attribute_name(:first_phone) %></dt>
          <dd>
            <%= @customer.first_phone.presence || "—" %>
            <% if @customer.second_phone.present? %>
              <br><span class="text-muted"><%= @customer.second_phone %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt><%= Customer.human_attribute_name(:address) %></dt>
          <dd>
            <%= @customer.address.presence || "—" %>
            <% location = [@customer.post_code, @customer.province].compact_blank.join(", ") %>
            <% if location.present? %>
              <br><span class="text-muted"><%= location %></span>
            <% end %>
          </dd>
        </div>
        <div>
          <dt><%= t(".document") %></dt>
          <dd><%= [@customer.document_type, @customer.document_number].compact_blank
              .join(" · ")
              .presence || "—" %></dd>
        </div>
        <div>
          <dt><%= Customer.human_attribute_name(:born_on) %></dt>
          <dd><%= @customer.born_on ? l(@customer.born_on, format: :display) : "—" %></dd>
        </div>
        <div>
          <dt><%= Customer.human_attribute_name(:sex) %></dt>
          <dd><%= @customer.sex.present? ? t(@customer.sex.downcase, scope: "customers.sex", default: @customer.sex) : "—" %></dd>
        </div>
        <div>
          <dt><%= t("customers.customer_since") %></dt>
          <dd><%= l(@customer.created_at, format: :display) %></dd>
        </div>
      </dl>
    </div>
  </aside>

  <section class="customer-profile__main">
    <header class="customer-profile__section-header">
      <div>
        <h2 class="section__title"><%= t(".pets") %></h2>
        <p class="text-muted"><%= t(".pets_count", count: @pets.size) %></p>
      </div>
      <%= link_to new_customer_pet_path(@customer), class: "btn btn--primary" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
            d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"
          /></svg>
        <%= t(".new_pet") %>
      <% end %>
    </header>

    <% if @pets.any? %>
      <div class="pets-grid">
        <% @pets.each do |pet| %>
          <%= link_to customer_pet_path(@customer, pet, return_to: request.fullpath), class: "pet-link" do %>
            <article class="card card--interactive pet-card">
              <div class="pet-card__media">
                <% if pet.photo.attached? %>
                  <%= image_tag pet.photo.variant(resize_to_fill: [640, 400]),
                  alt: pet.name.to_s,
                  class: "pet-card__photo" %>
                <% else %>
                  <span class="pet-card__placeholder"><%= render "shared/paw_icon" %></span>
                <% end %>
              </div>

              <div class="pet-card__body">
                <div class="pet-card__header">
                  <h3 class="pet-card__name"><%= pet.name.presence || t("shared.unnamed_pet") %></h3>
                  <% if pet.species.present? %>
                    <span class="badge badge--primary"><%= pet.species %></span>
                  <% end %>
                </div>
                <% if pet.breed.present? %>
                  <p class="pet-card__breed"><%= pet.breed %></p>
                <% end %>

                <dl class="pet-card__facts">
                  <div>
                    <dt><%= Pet.human_attribute_name(:sex) %></dt>
                    <dd><%= pet.sex.present? ? t(pet.sex.downcase, scope: "pets.sex", default: pet.sex) : "—" %></dd>
                  </div>
                  <div>
                    <dt><%= t(".age") %></dt>
                    <dd><%= pet.born_on ? distance_of_time_in_words(pet.born_on, Date.current) : "—" %></dd>
                  </div>
                  <div>
                    <dt><%= Pet.human_attribute_name(:color) %></dt>
                    <dd><%= pet.color.presence || "—" %></dd>
                  </div>
                  <div>
                    <dt><%= t(".microchip") %></dt>
                    <dd title="<%= pet.transponder_location %>"><%= pet.transponder_number.presence || "—" %></dd>
                  </div>
                </dl>
              </div>

              <% if pet.notes.present? %>
                <footer class="card__footer pet-card__notes"><p><%= pet.notes %></p></footer>
              <% end %>
            </article>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <%= render "shared/paw_icon" %>
        <p class="empty-state__title"><%= t(".no_pets") %></p>
        <p><%= t(".no_pets_hint") %></p>
      </div>
    <% end %>

    <header class="customer-profile__section-header customer-profile__section-header--spaced">
      <h2 class="section__title"><%= t(".history") %></h2>
    </header>

    <%# Same pattern as invoices#index: any change submits the form (debounced by
        search_controller.js) into the "history" frame below, so only the table is
        replaced and the pets above stay put. URL: /customers/1?history=invoices&q=…&from=…&to=… %>
    <%= form_with url: customer_path(@customer), method: :get, role: "search", class: "history-filters",
        data: { controller: "search", turbo_frame: "history", turbo_action: "replace" } do %>
      <%= label_tag :history, t(".history_type"), class: "sr-only" %>
      <%= select_tag :history,
            options_for_select([[t(".appointments"), "appointments"], [t(".invoices"), "invoices"]], @history),
            class: "select history-filters__type",
            data: { action: "change->search#submit" } %>

      <div class="search-field history-filters__search">
        <%= render "shared/icons/magnifying_glass" %>
        <%= label_tag :q, t(".search_label"), class: "sr-only" %>
        <%= search_field_tag :q, @query,
              class: "input",
              placeholder: t(".search_placeholder"),
              autocomplete: "off",
              data: { action: "input->search#submit" } %>
      </div>

      <div class="history-filters__dates">
        <%= label_tag :from, t(".from"), class: "history-filters__label" %>
        <%= date_field_tag :from, @from, class: "input", data: { action: "change->search#submit" } %>
        <%= label_tag :to, t(".to"), class: "history-filters__label" %>
        <%= date_field_tag :to, @to, class: "input", data: { action: "change->search#submit" } %>
      </div>
    <% end %>

    <%# Everything that depends on the selected type lives inside the frame (count, "New…"
        button, table), so it all updates together. target: "_top" so links open the full page %>
    <%= turbo_frame_tag "history", target: "_top" do %>
      <% filtered = @query.present? || @from || @to %>

      <% if @history == "invoices" %>
        <div class="history-toolbar">
          <p class="history-toolbar__count"><%= t(".invoices_count", count: @invoices.size) %></p>
          <%= link_to new_invoice_path(customer_id: @customer.id), class: "btn btn--secondary btn--sm" do %>
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
                d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"
              /></svg>
            <%= t(".new_invoice") %>
          <% end %>
        </div>

        <% if @invoices.any? %>
          <%= render "invoices/table", invoices: @invoices, show_customer: false %>
        <% elsif filtered %>
          <div class="empty-state">
            <%= render "shared/icons/magnifying_glass" %>
            <p class="empty-state__title"><%= t(".no_matching_invoices") %></p>
            <p><%= t(".no_matches_hint") %></p>
          </div>
        <% else %>
          <div class="empty-state">
            <%= render "shared/icons/document_text" %>
            <p class="empty-state__title"><%= t(".no_invoices") %></p>
            <p><%= t(".no_invoices_hint") %></p>
          </div>
        <% end %>
      <% else %>
        <div class="history-toolbar">
          <p class="history-toolbar__count"><%= t(".appointments_count", count: @appointments.size) %></p>
          <%# Same calendar "booking for this customer" mode as the sidebar button %>
          <%= link_to appointments_path(customer_id: @customer.id), class: "btn btn--secondary btn--sm" do %>
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
                d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"
              /></svg>
            <%= t(".new_appointment") %>
          <% end %>
        </div>

        <% if @appointments.any? %>
          <div class="table-wrapper">
            <table class="table">
              <thead>
                <tr>
                  <th><%= t(".columns.when") %></th>
                  <th><%= t(".columns.appointment") %></th>
                  <th><%= t(".columns.pet") %></th>
                  <th><%= t(".columns.staff") %></th>
                  <th><%= t(".columns.room") %></th>
                  <th><%= t(".columns.invoice") %></th>
                </tr>
              </thead>
              <tbody>
                <% @appointments.each do |appointment| %>
                  <tr>
                    <td class="table__numeric">
                      <%= l(appointment.starts_at, format: :display) %><br>
                      <span class="text-subtle"><%= l(appointment.starts_at, format: :hour) %>–<%= l(appointment.ends_at, format: :hour) %></span>
                    </td>
                    <td class="table__truncate">
                      <%= link_to appointment.title.presence || t("shared.untitled"), edit_appointment_path(appointment) %>
                      <% if appointment.starts_at.future? %>
                        <span class="badge badge--info"><%= t(".upcoming") %></span>
                      <% end %>
                    </td>
                    <td>
                      <% if appointment.pet %>
                        <%= link_to appointment.pet.name.presence || t("shared.unnamed_pet"), customer_pet_path(@customer, appointment.pet, return_to: request.fullpath) %>
                      <% else %>
                        <span class="text-subtle">—</span>
                      <% end %>
                    </td>
                    <td><%= appointment.employee.display_name %></td>
                    <td><%= appointment.room.name %></td>
                    <td>
                      <%# One invoice per appointment: link to it, or offer to create it %>
                      <% if appointment.invoice %>
                        <%= link_to appointment.invoice.number.presence || t("invoices.number", id: appointment.invoice.id),
                              invoice_path(appointment.invoice, return_to: request.fullpath), class: "badge badge--success" %>
                      <% else %>
                        <%= link_to t(".create_invoice"), new_invoice_path(appointment_id: appointment.id), class: "btn btn--ghost btn--sm" %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% elsif filtered %>
          <div class="empty-state">
            <%= render "shared/icons/magnifying_glass" %>
            <p class="empty-state__title"><%= t(".no_matching_appointments") %></p>
            <p><%= t(".no_matches_hint") %></p>
          </div>
        <% else %>
          <div class="empty-state">
            <%= render "shared/icons/calendar" %>
            <p class="empty-state__title"><%= t(".no_appointments") %></p>
            <p><%= t(".no_appointments_hint") %></p>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
