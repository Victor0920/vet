<% full_name = [@customer.first_name, @customer.first_surname, @customer.second_surname].compact_blank.join(" ") %>
<% content_for :title, "Edit #{full_name.presence || "customer ##{@customer.id}"}" %>

<%= link_to customer_path(@customer), class: "back-link" do %>
  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"/></svg>
  Done editing
<% end %>

<div class="customer-profile">
  <aside class="card customer-profile__sidebar">
    <div class="customer-profile__header">
      <%# Same trick as the pet photo: the avatar is a <label> for a hidden file input,
          and the auto-submit Stimulus controller uploads as soon as a file is chosen. %>
      <%= form_with model: @customer, class: "avatar-upload", data: { controller: "auto-submit" } do |form| %>
        <%= form.label :photo, class: "avatar-upload__trigger", title: "Change photo" do %>
          <% if @customer.photo.attached? %>
            <%= image_tag @customer.photo.variant(resize_to_fill: [192, 192]), alt: full_name, class: "avatar avatar--xl avatar--photo" %>
          <% else %>
            <span class="avatar avatar--xl"><%= @customer.first_name.to_s.first %><%= @customer.first_surname.to_s.first %></span>
          <% end %>
          <span class="avatar-upload__overlay">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M1 8a2 2 0 0 1 2-2h.93a2 2 0 0 0 1.664-.89l.812-1.22A2 2 0 0 1 8.07 3h3.86a2 2 0 0 1 1.664.89l.812 1.22A2 2 0 0 0 16.07 6H17a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8Zm13.5 3a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM10 14a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/></svg>
            <span class="sr-only"><%= @customer.photo.attached? ? "Change photo" : "Upload photo" %></span>
          </span>
        <% end %>
        <%= form.file_field :photo, accept: "image/*", class: "sr-only", data: { action: "change->auto-submit#submit" } %>
      <% end %>
      <p class="text-subtle text-xs">Click the photo to <%= @customer.photo.attached? ? "change" : "upload" %> it</p>

      <div>
        <h1 class="customer-profile__name"><%= full_name.presence || "Unnamed customer" %></h1>
        <p class="text-subtle text-xs">Customer #<%= @customer.id %></p>
      </div>
    </div>

    <div class="card__body">
      <dl class="details">
        <div>
          <dt>Pets</dt>
          <dd><%= @customer.pets.map(&:name).compact_blank.to_sentence.presence || "None yet" %></dd>
        </div>
        <div>
          <dt>Customer since</dt>
          <dd><%= @customer.created_at.strftime("%b %-d, %Y") %></dd>
        </div>
        <div>
          <dt>Last updated</dt>
          <dd><%= time_ago_in_words(@customer.updated_at) %> ago</dd>
        </div>
      </dl>
    </div>
  </aside>

  <div class="customer-profile__main stack">
    <section class="card">
      <header class="card__header">
        <div>
          <h2 class="card__title">Personal</h2>
          <p class="card__description">Click the pencil next to a field to edit it.</p>
        </div>
      </header>
      <dl class="field-list">
        <%= render "shared/editable_field", model: @customer, attribute: :first_name, label: "First name" %>
        <%= render "shared/editable_field", model: @customer, attribute: :first_surname, label: "First surname" %>
        <%= render "shared/editable_field", model: @customer, attribute: :second_surname, label: "Second surname" %>
        <%= render "shared/editable_field", model: @customer, attribute: :sex, label: "Sex",
              input: :select, choices: ["Male", "Female"] %>
        <%= render "shared/editable_field", model: @customer, attribute: :born_on, label: "Born",
              input: :date_field, value: @customer.born_on&.strftime("%b %-d, %Y") %>
        <%= render "shared/editable_field", model: @customer, attribute: :document_type, label: "Document type" %>
        <%= render "shared/editable_field", model: @customer, attribute: :document_number, label: "Document number" %>
      </dl>
    </section>

    <section class="card">
      <header class="card__header">
        <h2 class="card__title">Contact</h2>
      </header>
      <dl class="field-list">
        <%= render "shared/editable_field", model: @customer, attribute: :email, label: "Email", input: :email_field %>
        <%= render "shared/editable_field", model: @customer, attribute: :first_phone, label: "Phone", input: :telephone_field %>
        <%= render "shared/editable_field", model: @customer, attribute: :second_phone, label: "Second phone", input: :telephone_field %>
      </dl>
    </section>

    <section class="card">
      <header class="card__header">
        <h2 class="card__title">Address</h2>
      </header>
      <dl class="field-list">
        <%= render "shared/editable_field", model: @customer, attribute: :address, label: "Address" %>
        <%= render "shared/editable_field", model: @customer, attribute: :post_code, label: "Post code" %>
        <%= render "shared/editable_field", model: @customer, attribute: :province, label: "Province" %>
      </dl>
    </section>
  </div>
</div>
