<% reset_url = edit_password_url(@employee.password_reset_token) %>
<% expires_in = distance_of_time_in_words(0, @employee.password_reset_token_expires_in) %>

<h1 style="margin: 0 0 8px; font-size: 20px; font-weight: 600; line-height: 1.3; color: #0f172a;">
  Reset your password
</h1>

<p style="margin: 0 0 24px;">
  We received a request to reset the password for
  <strong style="color: #0f172a;"><%= @employee.email_address %></strong>.
  Click the button below to choose a new one.
</p>

<%# "Bulletproof" button: a table cell with a background works in Outlook too %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px;">
  <tr>
    <td align="center" bgcolor="#0d9488" style="border-radius: 6px; background-color: #0d9488;">
      <%= link_to "Reset password", reset_url,
        style: "display: inline-block; padding: 12px 24px; font-size: 14px; font-weight: 600; color: #ffffff; text-decoration: none; border-radius: 6px;" %>
    </td>
  </tr>
</table>

<p style="margin: 0 0 24px;">
  This link will expire in <%= expires_in %>. If you didn't ask to reset your
  password, you can safely ignore this email — your password won't change.
</p>

<hr style="margin: 0 0 16px; border: 0; border-top: 1px solid #e2e8f0;">

<p style="margin: 0; font-size: 12px; color: #64748b;">
  Button not working? Copy and paste this link into your browser:<br>
  <%= link_to reset_url, reset_url, style: "color: #0f766e; word-break: break-all;" %>
</p>
