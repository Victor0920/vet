<h1>All Conversations</h1>

<div class="conversations-grid">
  <% @conversations.each do |conversation| %>

    <%= link_to conversation_path(conversation), class: "conversation-container" do %>
      <div>
        <%= render ConversationComponent.new(
          conversation: conversation,
          link_messages: false,
        ) %>
      </div>
    <% end %>
  <% end %>
</div>

<div>
  <h2>Create new conversation</h2>
  <%= form_with model: @conversation, local: true do |form| %>
    <div>
      <%= form.label :user_id %>
      <%= form.collection_select :user_id, @users, :id, :name %>
    </div>

    <%= form.submit "Create conversation", class: "" %>

  <% end %>
</div>
