<% content_for :title, t(".title") %>

<div class="page-header">
  <div>
    <h1 class="page-header__title"><%= t(".title") %></h1>
    <p class="page-header__subtitle"><%= t(".subtitle") %></p>
  </div>
  <div class="page-header__actions">
    <%# Loads conversations/new (the customer picker) into the "modal" frame at the bottom of this page %>
    <%= link_to new_conversation_path, class: "btn btn--primary", data: { turbo_frame: "modal" } do %>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path
          d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"
        /></svg>
      <%= t(".new_conversation") %>
    <% end %>
  </div>
</div>

<%# Same search as customers#index: typing submits (debounced, search_controller.js) into the
    "conversations" frame below, so only the list is replaced and the input keeps focus.
    It matches the customer (name, phone, email…) or the text of any message %>
<%= form_with url: conversations_path, method: :get, role: "search", class: "conversations-search",
    data: { controller: "search", turbo_frame: "conversations", turbo_action: "replace" } do %>
  <div class="search-field">
    <%= render "shared/icons/magnifying_glass" %>
    <%= label_tag :q, t(".search_label"), class: "sr-only" %>
    <%= search_field_tag :q, @query, class: "input", placeholder: t(".search_placeholder"),
          autocomplete: "off", data: { action: "input->search#submit" } %>
  </div>
<% end %>

<%# target: "_top" so the rows open the chat as a full page, not inside the frame %>
<%= turbo_frame_tag "conversations", target: "_top" do %>
  <p class="conversations-search__count">
    <% if @query.present? %>
      <%= t(".count_matching", count: @conversations.size, query: @query) %>
    <% else %>
      <%= t(".count", count: @conversations.size) %>
    <% end %>
  </p>

  <% if @conversations.any? %>
    <%# An inbox: chats with unread messages first, then the newest activity (Conversation.unread_first).
        Each row: photo, name, the last message on one line, how long ago, and the unread count %>
    <ul class="card conversation-list">
      <% @conversations.each do |conversation| %>
        <% customer = conversation.customer %>
        <% message = conversation.last_message %>
        <% unread = conversation.unread_count %>
        <li>
          <%= link_to conversation_path(conversation),
                class: ["conversation-row", ("conversation-row--unread" if unread.positive?)] do %>
            <% if customer.photo.attached? %>
              <%= image_tag customer.photo.variant(:small), alt: "", class: "avatar avatar--photo" %>
            <% else %>
              <span class="avatar"><%= customer.first_name.to_s.first %><%= customer.first_surname.to_s.first %></span>
            <% end %>

            <span class="conversation-row__main">
              <span class="conversation-row__top">
                <span class="conversation-row__name"><%= customer.full_name %></span>
                <span class="conversation-row__time">
                  <%= t(".ago", time: time_ago_in_words(message&.created_at || conversation.updated_at)) %>
                </span>
              </span>
              <span class="conversation-row__bottom">
                <span class="conversation-row__preview">
                  <% if message %>
                    <%# Who wrote it, unless it was the customer (like WhatsApp's "Tú:") %>
                    <% if message.admin? || message.bot? %>
                      <span class="conversation-row__sender"><%= t(".sender.#{message.sender}") %></span>
                    <% end %>
                    <%= message.text %>
                  <% else %>
                    <span class="conversation-row__empty"><%= t(".no_messages") %></span>
                  <% end %>
                </span>
                <%# Like WhatsApp: a green count of what the customer sent that nobody has opened yet %>
                <% if unread.positive? %>
                  <span class="conversation-row__unread" aria-label="<%= t(".unread", count: unread) %>"><%= unread %></span>
                <% end %>
              </span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif @query.present? %>
    <div class="empty-state">
      <%= render "shared/icons/magnifying_glass" %>
      <p class="empty-state__title"><%= t(".no_matches", query: @query) %></p>
      <p><%= t(".no_matches_hint") %></p>
    </div>
  <% else %>
    <div class="empty-state">
      <%= render "shared/icons/messages" %>
      <p class="empty-state__title"><%= t(".empty") %></p>
      <p><%= t(".empty_hint") %></p>
    </div>
  <% end %>
<% end %>

<%# Empty until "New conversation" loads conversations/new into it %>
<%= turbo_frame_tag "modal" %>
