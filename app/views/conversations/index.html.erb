<h1>All Conversations</h1>

<div>
  <% @conversations.each do |conversation| %>
    <h2>Conversation:
      <%= conversation.id %>
    </h2>

    <div>
      <% conversation.messages.each do |message| %>
        <div><%= message.text %></div>
      <% end %>
    </div>

    <%= link_to "Go to conversation", conversation_path(conversation) %>
  <% end %>
</div>
