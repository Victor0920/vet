<% content_for :title, @user&.name.presence || "Conversation ##{@conversation.id}" %>

<div class="chat">
  <section class="card chat__main">
    <header class="chat__header">
      <div class="chat__contact">
        <span class="avatar"><%= @user&.name.to_s.first %></span>
        <div>
          <h1 class="chat__title"><%= @user&.name.presence || "Unknown client" %></h1>
          <p class="chat__subtitle">Conversation #<%= @conversation.id %></p>
        </div>
      </div>

      <%= button_to "Delete",
        @conversation,
        method: :delete,
        class: "btn btn--danger-ghost btn--sm",
        form: { data: { turbo_confirm: "Delete this conversation? This can't be undone." } } %>
    </header>

    <div class="chat__messages">
      <%= render ConversationComponent.new(conversation: @conversation) %>
    </div>

    <% if @message.errors.any? %>
      <div class="chat__errors">
        <p class="alert alert--danger"><%= @message.errors.full_message.first %></p>
      </div>
    <% end %>

    <%= form_with model: @message, local: true, class: "chat__composer" do |form| %>
      <%= form.hidden_field :conversation_id, value: @conversation.id %>

      <%= form.label :sender, "Send as", class: "sr-only" %>
      <%= form.select :sender, [["Bot", 1], ["Admin", 2]], {}, class: "select select--sm" %>

      <%= form.label :text, "Message", class: "sr-only" %>
      <%= form.text_field :text, class: "input", placeholder: "Write a message…", autocomplete: "off" %>

      <%= form.submit "Send", class: "btn btn--primary" %>
    <% end %>
  </section>

  <aside class="card chat__sidebar">
    <div class="chat__profile">
      <span class="avatar avatar--lg"><%= @user&.name.to_s.first %></span>
      <div>
        <h2 class="card__title"><%= @user&.name.presence || "Unknown client" %></h2>
        <p class="text-subtle text-xs">Client</p>
      </div>
    </div>
    <div class="card__body">
      <dl class="details">
        <div>
          <dt>Phone</dt>
          <dd><%= @user&.phone.presence || "—" %></dd>
        </div>
        <div>
          <dt>Messages</dt>
          <dd><%= @conversation.messages.size %></dd>
        </div>
        <div>
          <dt>Started</dt>
          <dd><%= @conversation.created_at.strftime("%b %-d, %Y") %></dd>
        </div>
      </dl>
    </div>
  </aside>
</div>
