<h1>Conversation
  <%= @conversation.id %></h1>

<div class="conversations-show">
  <div>
    <%= button_to "Delete Conversation",
    @conversation,
    method: :delete,
    data: {
      confirm: "Are you sure?",
    } %>

    <%= render ConversationComponent.new(conversation: @conversation) %>

    <%= form_with model: @message, local: true do |form| %>
      <%= form.hidden_field :conversation_id, value: @conversation.id %>
      <% if form.object.errors.any? %>
        <p class="error"><%= form.object.errors.full_message.first %></p>
      <% end %>
      <div class="message-input">
        <%= form.text_field :text %>
      </div>

      <div>
        <%= form.label :sender %>
        <%= form.select :sender, [["Bot", 1], ["Admin", 2]] %>
      </div>

      <div>
        <%= form.submit %>
      </div>
    <% end %>
  </div>

  <div>
    <%= @user.name %>

  </div>
</div>
